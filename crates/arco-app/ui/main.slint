    filter: string,
    has-primary: bool,
    has-secondary: bool,
    primary: color,
    secondary: color,
    primary-ink: color,
    secondary-ink: color,
    detailed: bool,
    thumbnails: bool,
    comments: bool,
    sort-column: string,
    wdx-sort-index: int,
    descending: bool,
    volume: string,
    drive: string,
    local: bool,
    custom-columns: [FileColumn],
    custom-width: int,
