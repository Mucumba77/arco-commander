    keyboard := FocusScope {
        width: 100%; height: 100%;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.drive-side >= 0) { return reject; }
            if (root.settings-open) {
                if (event.text == Key.Escape) { root.action("close-settings"); return accept; }
                return reject;
            }
            if (root.dialog-kind != "") {
                if (event.text == Key.Escape) { root.action("close-dialog"); return accept; }
                return reject;
            }
            if (event.text == Key.Escape && (left-view.cancel-path() || right-view.cancel-path())) { return accept; }
            if (event.text == Key.Escape && command.has-focus) { keyboard.focus(); return accept; }
            if (event.text == Key.Escape && root.job-active) { root.action("cancel-job"); return accept; }
            return reject;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            if root.settings.toolbar : Rectangle {
                height: 40px;
                background: Colors.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Colors.edge;
                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    spacing: 5px;
                    Image {
                        source: @image-url("icons/mark.svg");
                        width: 27px;
                        height: 27px;
                    }
                    Text { text: "Arco Commander"; color: Colors.text; font-weight: 800; font-size: 14px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Colors.edge; }
                    if root.top-buttons.length == 0 : HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 5px;
                    NavButton { icon: @image-url("icons/refresh.svg"); label: @tr("Aktualisieren"); clicked => { root.action("refresh"); } }
                    NavButton { icon: @image-url("icons/folder.svg"); label: @tr("Kurz- und Detailansicht wechseln"); clicked => { root.action("details"); } }
                    NavButton { icon: @image-url("icons/eye.svg"); label: @tr("Schnellansicht"); checkable: true; checked: root.quick-open; clicked => { root.action("quick-view"); } }
                    NavButton { icon: @image-url("icons/move.svg"); label: @tr("Fenster tauschen"); clicked => { root.action("swap"); } }
                    Rectangle { width: 1px; background: Colors.edge; }
                    NavButton { icon: @image-url("icons/archive.svg"); label: @tr("Dateien packen"); clicked => { root.action("zip-pack"); } }
                    NavButton { icon: @image-url("icons/archive-extract.svg"); label: @tr("Archiv entpacken"); clicked => { root.action("zip-extract"); } }
                    NavButton { icon: @image-url("icons/network.svg"); label: @tr("FTP-Verbindungen"); clicked => { root.action("ftp-profiles"); } }
                    Rectangle { width: 1px; background: Colors.edge; }
                    NavButton { icon: @image-url("icons/search.svg"); label: @tr("Dateien suchen"); clicked => { root.action("search"); } }
                    NavButton { icon: @image-url("icons/compare.svg"); label: @tr("Dateiinhalt vergleichen"); clicked => { root.action("compare"); } }
                    NavButton { icon: @image-url("icons/sync.svg"); label: @tr("Verzeichnisse synchronisieren"); clicked => { root.action("sync"); } }
                    }
                    if root.top-buttons.length > 0 : Flickable {
                        horizontal-stretch: 1;
                        viewport-width: max(self.width, top-bar.preferred-width);
                        viewport-height: self.height;
                        top-bar := HorizontalLayout {
                            width: parent.viewport-width;
                            height: parent.viewport-height;
                            alignment: start;
                            spacing: 5px;
                            for item[index] in root.top-buttons : CustomBarButton {
                                label: item.label;
                                icon-name: item.icon;
                                custom-icon: item.custom-icon;
                                clicked => { root.custom-button(0, index); }
                            }
                        }
                    }
                    if root.top-buttons.length == 0 : Rectangle { horizontal-stretch: 1; }
                    NavButton { icon: Colors.light ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg"); label: @tr("Farbschema wechseln"); clicked => { root.action("theme"); } }
                    NavButton { icon: @image-url("icons/settings.svg"); label: @tr("Einstellungen"); clicked => { root.action("settings"); } }
                    ComboBox {
                        model: root.tools-menu;
                        current-index: 0;
                        width: 155px;
                        accessible-label: @tr("Werkzeuge");
                        selected => { root.tool-selected(self.current-index); self.current-index = 0; }
                    }
                }
            }
            panels := Rectangle {
                vertical-stretch: 1;
                property <length> gap: root.settings.panel-toolbar ? 42px : 8px;
                property <length> sidebar: root.separate-tree-mode == 1 ? clamp(self.width * 0.22, 140px, 240px) : 0px;
                property <length> files-width: self.width - self.sidebar;
                if root.separate-tree-mode == 1 : FolderTree {
                    tree-data: root.active-panel == 0 ? root.left-tree : root.right-tree;
                    title: "Ordnerbaum · " + (root.active-panel == 0 ? @tr("Links") : @tr("Rechts"));
                    x: 0px; y: 0px;
                    width: panels.sidebar - 4px; height: panels.height;
                    tree-row(index, operation) => { root.tree-row(root.active-panel, index, operation); }
                    close => { root.action("separate-tree-off"); }
                    return-to-list => { keyboard.focus(); }
                }
                left-view := FilePanel {
                    tree-data: root.separate-tree-mode == 1 ? {} : root.left-tree;
                    visible: !root.quick-open || root.active-panel == 0;
                    data: root.left;
                    cursor: root.left-cursor;
                    summary: root.left-summary;
                    busy: root.left-busy;
                    active: root.active-panel == 0;
                    side: @tr("LINKS");
                    drives: root.drives;
                    settings: root.settings;
                    x: panels.sidebar; y: 0px;
                    width: root.stacked ? panels.files-width : (panels.files-width - panels.gap) * root.split-ratio;
                    height: root.stacked ? (parent.height - panels.gap) * root.split-ratio : parent.height;
                    action(command) => { root.panel-action(0, command); }
                    navigate(path) => { root.navigate(0, path); }
                    select-crumb(index) => { root.select-crumb(0, index); }
                    filter(value) => { root.filter(0, value); }
                    click-row(index, toggle, range, open) => { root.click-row(0, index, toggle, range, open); }
                    tree-row(index, operation) => { root.tree-row(0, index, operation); }
                    context-row(index, extended) => { root.context-row(0, index, extended); }
                    drag-row(index) => { root.drag-row(0, index); }
                    select-tab(index) => { root.select-tab(0, index); }
                    return-to-list => { keyboard.focus(); }
                }
                right-view := FilePanel {
                    tree-data: root.separate-tree-mode == 1 ? {} : root.right-tree;
                    visible: !root.quick-open || root.active-panel == 1;
                    data: root.right;
                    cursor: root.right-cursor;
                    summary: root.right-summary;
                    busy: root.right-busy;
                    active: root.active-panel == 1;
                    side: @tr("RECHTS");
                    drives: root.drives;
                    settings: root.settings;
                    x: root.stacked ? panels.sidebar : left-view.x + left-view.width + panels.gap;
                    y: root.stacked ? left-view.height + panels.gap : 0px;
                    width: parent.width - self.x;
                    height: root.stacked ? parent.height - self.y : parent.height;
                    action(command) => { root.panel-action(1, command); }
                    navigate(path) => { root.navigate(1, path); }
                    select-crumb(index) => { root.select-crumb(1, index); }
                    filter(value) => { root.filter(1, value); }
                    click-row(index, toggle, range, open) => { root.click-row(1, index, toggle, range, open); }
                    tree-row(index, operation) => { root.tree-row(1, index, operation); }
                    context-row(index, extended) => { root.context-row(1, index, extended); }
                    drag-row(index) => { root.drag-row(1, index); }
                    select-tab(index) => { root.select-tab(1, index); }
                    return-to-list => { keyboard.focus(); }
                }
                if root.quick-open : QuickView {
                    x: root.active-panel == 0 ? right-view.x : left-view.x;
                    y: root.active-panel == 0 ? right-view.y : left-view.y;
                    width: root.active-panel == 0 ? right-view.width : left-view.width;
                    height: root.active-panel == 0 ? right-view.height : left-view.height;
                    title: root.quick-title;
                    note: root.quick-note;
                    body: root.quick-text;
                    embedded: root.quick-embedded;
                    bounds-changed(bounds) => { root.quick-bounds = bounds; }
                    preview-image: root.quick-image;
                    close => { root.action("quick-view"); }
                }
                TouchArea {
                    x: root.stacked ? panels.sidebar : left-view.x + left-view.width;
                    y: root.stacked ? left-view.height : 0px;
                    width: root.stacked ? panels.files-width : panels.gap;
                    height: root.stacked ? panels.gap : panels.height;
                    mouse-cursor: root.stacked ? MouseCursor.row-resize : MouseCursor.col-resize;
                    double-clicked => { root.split-ratio = 0.5; }
                    moved => {
                        if (self.pressed) {
                            let position = root.stacked
                                ? self.absolute-position.y + self.mouse-y - panels.absolute-position.y
                                : self.absolute-position.x + self.mouse-x - panels.absolute-position.x - panels.sidebar;
                            let span = root.stacked ? panels.height : panels.files-width;
                            root.split-ratio = clamp((position - panels.gap / 2) / (span - panels.gap), 0.37, 0.63);
                        }
                    }
                    if !root.settings.panel-toolbar : Rectangle {
                        width: root.stacked ? 36px : 2px;
                        height: root.stacked ? 2px : 36px;
                        background: parent.has-hover || parent.pressed ? Colors.accent : Colors.edge;
                        border-radius: 1px;
                    }
                }
                if root.settings.panel-toolbar : Rectangle {
                    property <int> button-count: root.middle-buttons.length > 0 ? root.middle-buttons.length : self.actions.length;
                    property <[PanelAction]> actions: [
                        { icon: @image-url("icons/eye.svg"), label: @tr("Anzeigen"), command: "view" },
                        { icon: @image-url("icons/edit.svg"), label: @tr("Bearbeiten"), command: "edit" },
                        { icon: @image-url("icons/copy.svg"), label: @tr("Kopieren"), command: "copy" },
                        { icon: @image-url("icons/move.svg"), label: @tr("Verschieben"), command: "move" },
                        { icon: @image-url("icons/archive.svg"), label: @tr("Dateien packen"), command: "zip-pack" },
                        { icon: @image-url("icons/folderplus.svg"), label: @tr("Neuer Ordner"), command: "mkdir" },
                    ];
                    x: root.stacked ? panels.sidebar + (panels.files-width - self.width) / 2 : left-view.x + left-view.width + 4px;
                    y: root.stacked ? left-view.height + 4px : (panels.height - self.height) / 2;
                    width: root.stacked ? self.button-count * 38px - 4px : 34px;
                    height: root.stacked ? 34px : self.button-count * 38px - 4px;
                    for item[i] in self.actions : NavButton {
                        visible: root.middle-buttons.length == 0;
                        x: root.stacked ? i * 38px : 0px;
                        y: root.stacked ? 0px : i * 38px;
                        icon: item.icon;
                        label: item.label;
                        clicked => { root.action(item.command); }
                    }
                    for item[i] in root.middle-buttons : CustomBarButton {
                        x: root.stacked ? i * 38px : 0px;
                        y: root.stacked ? 0px : i * 38px;
                        label: item.label;
                        icon-name: item.icon;
                        custom-icon: item.custom-icon;
                        clicked => { root.custom-button(1, i); }
                    }
                }
            }
            Rectangle {
                height: root.settings.command-line ? 32px : 0px;
                visible: root.settings.command-line;
                HorizontalLayout {
                spacing: 6px;
                DetailCell {
                    text: (root.active-panel == 0 ? root.left.path : root.right.path) + " >";
                    width: 220px;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
                command := LineEdit {
                    placeholder-text: "cd <Pfad> oder Arco-Befehl";
                    accessible-label: @tr("Arco-Befehlszeile");
                    horizontal-stretch: 1;
                    accepted(value) => {
                        if (root.command-line(value)) { self.text = ""; }
                    }
                }
                NavButton { icon: @image-url("icons/terminal.svg"); label: @tr("Terminal im aktiven Ordner öffnen"); clicked => { root.action("terminal"); } }
                }
            }
            if root.settings.function-keys : HorizontalLayout {
                spacing: 6px;
                ActionButton { icon: @image-url("icons/refresh.svg"); text: root.button-label("Neu laden", root.shortcut-labels.refresh); clicked => { root.action("refresh"); } }
                ActionButton { icon: @image-url("icons/eye.svg"); text: root.button-label(@tr("Anzeigen"), root.shortcut-labels.view); clicked => { root.action("view"); } }
                ActionButton { icon: @image-url("icons/edit.svg"); text: root.button-label(@tr("Bearbeiten"), root.shortcut-labels.edit); clicked => { root.action("edit"); } }
                ActionButton { icon: @image-url("icons/copy.svg"); text: root.button-label(@tr("Kopieren"), root.shortcut-labels.copy); clicked => { root.action("copy"); } }
                ActionButton { icon: @image-url("icons/move.svg"); text: root.button-label(@tr("Verschieben"), root.shortcut-labels.move-file); clicked => { root.action("move"); } }
                ActionButton { icon: @image-url("icons/folderplus.svg"); text: root.button-label(@tr("Neuer Ordner"), root.shortcut-labels.mkdir); clicked => { root.action("mkdir"); } }
                ActionButton { icon: @image-url("icons/trash.svg"); text: root.button-label("Löschen", root.shortcut-labels.delete); clicked => { root.action("delete"); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Image { source: root.job-active ? @image-url("icons/sync.svg") : @image-url("icons/check.svg"); width: 15px; height: 15px; colorize: Colors.accent; }
                Text { text: root.job-active ? root.job-status : root.status; color: root.job-active ? Colors.accent : Colors.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-size: 12px; min-height: 24px; }
                if root.job-active : Button { text: @tr("Abbrechen"); clicked => { root.action("cancel-job"); } }
            }
        }

        if root.settings-open : Rectangle {
            width: 100%; height: 100%;
            background: #050a14a8;
            TouchArea { }
            SettingsCard {
                width: min(800px, parent.width - 36px);
                height: min(450px, parent.height - 26px);
                current: root.settings;
                shortcut-commands: root.shortcut-commands;
                shortcut-assigned: root.shortcut-assigned;
                shortcut-query: root.shortcut-query;
                shortcut-command: root.shortcut-command;
                shortcut-title: root.shortcut-title;
                shortcut-candidate: root.shortcut-candidate;
                shortcut-notice: root.shortcut-notice;
                shortcut-recording: root.shortcut-recording;
                shortcut-conflict: root.shortcut-conflict;
                shortcut-filter(value) => { root.shortcut-filter(value); }
                select-shortcut-command(id) => { root.select-shortcut-command(id); }
                edit-shortcut(operation, key) => { root.edit-shortcut(operation, key); }
                apply(value, close) => { root.apply-settings(value, close); }
                close => { root.action("close-settings"); }
            }
        }
        if root.drive-side >= 0 : Rectangle {
            width: 100%; height: 100%;
            background: #050a14a8;
            TouchArea { clicked => { root.action("close-drives"); } }
            DrivePicker {
                x: root.drive-side == 0 ? left-view.absolute-position.x + 16px : min(parent.width - self.width - 12px, right-view.absolute-position.x + 16px);
                y: root.drive-side == 0 ? left-view.absolute-position.y + 13px : min(parent.height - self.height - 12px, right-view.absolute-position.y + 13px);
                width: 236px;
                height: 87px + min(7, root.drives.length) * 34px;
                title: root.drive-side == 0 ? @tr("Linkes Laufwerk wählen") : @tr("Rechtes Laufwerk wählen");
                drives: root.drives;
                initial: root.drive-selection;
                choose(value) => { root.choose-drive(value); }
                letter(value) => { return root.drive-letter(value); }
                cancel => { root.action("close-drives"); }
            }
        }
        if root.dialog-kind == "sync-options" || root.dialog-kind == "sync-review" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            if root.dialog-kind == "sync-options" : SyncOptionsCard {
                width: min(parent.width - 46px, 680px);
                height: min(parent.height - 46px, 565px);
                data: root.sync-draft;
                revision: root.sync-draft-revision;
                roots: root.sync-roots;
                presets: root.sync-presets;
                has-selection: root.sync-has-selection;
                archive-side: root.sync-archive-side;
                archive-writable: root.sync-archive-writable;
                archive-left-secret: root.sync-archive-left-secret;
                archive-right-secret: root.sync-archive-right-secret;
                ftp: root.sync-ftp;
                notice: root.sync-notice;
                configure(data, preset, operation, left, right) => {
                    root.sync-configure(data, preset, operation, left, right);
                }
                close => { root.action("close-dialog"); }
            }
            if root.dialog-kind == "sync-review" : SyncReviewCard {
                width: min(parent.width - 46px, 1100px);
                height: parent.height - 46px;
                roots: root.sync-roots;
                rows: root.sync-rows;
                summary: root.sync-summary;
                has-actions: root.sync-has-actions;
                has-deletes: root.sync-has-deletes;
                copy-only: root.sync-copy-only;
                comparison-only: root.sync-comparison-only;
                filter(value) => { root.sync-filter(value); }
                choose(index, action) => { root.sync-choose(index, action); }
                run(confirm-deletes) => { root.sync-run(confirm-deletes); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "ftp-browser" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            FtpBrowserCard {
                width: min(parent.width - 46px, 940px);
                height: parent.height - 46px;
                url: root.ftp-url;
                rows: root.ftp-rows;
                selection <=> root.ftp-cursor;
                has-parent: root.ftp-has-parent;
                detailed: root.ftp-detailed;
                busy: root.job-active;
                browse(operation, index) => { root.ftp-browse(operation, index); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "ftp-profiles" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            FtpProfilesCard {
                width: min(parent.width - 30px, 730px);
                height: min(parent.height - 30px, 560px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                profiles: root.ftp-profile-names;
                selected: root.ftp-profile-index;
                data: root.ftp-profile-data;
                revision: root.ftp-profile-revision;
                notice: root.ftp-profile-notice;
                select(index) => { root.ftp-profile-select(index); }
                operate(operation, data, password) => { root.ftp-profile-operate(operation, data, password); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "plugins" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            PluginManagerCard {
                width: min(parent.width - 30px, 880px);
                height: min(parent.height - 30px, 590px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                entries: root.plugin-entries;
                selection <=> root.plugin-selection;
                busy: root.job-active;
                operate(action, index) => { root.plugin-operate(action, index); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "advanced-search" : Rectangle {
            background: #050a14a8;
            width: 100%;
            height: 100%;
            TouchArea { }
            SearchCard {
                width: min(parent.width - 32px, 780px);
                height: min(parent.height - 32px, 660px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                draft: root.search-draft;
                profiles: root.search-profiles;
                notice: root.search-notice;
                base: root.search-base;
                has-selection: root.search-has-selection;
                archive: root.search-archive;
                wdx-profiles: root.search-wdx-profiles;
                configure(data, name, operation) => { root.search-configure(data, name, operation); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "transfer-conflict" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            FileConflictCard {
                width: min(parent.width - 32px, 950px);
                height: min(parent.height - 32px, 550px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.file-conflict;
                options: root.dialog-options;
                decide(option, for-all, name) => { root.submit(name, for-all ? "all" : "", option); }
                cancel => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "text-comparison" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            TextComparisonCard {
                width: min(parent.width - 32px, 1150px);
                height: min(parent.height - 32px, 650px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.diff-data;
                revision: root.diff-revision;
                busy: root.job-active;
                navigate(delta) => { root.diff-navigate(delta); }
                compare(ignore-case, ignore-space, ignore-eol) => { root.diff-options(ignore-case, ignore-space, ignore-eol); }
                save(side, edited, text) => { root.diff-save(side, edited, text); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind == "ntfs-options" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            NtfsOptionsCard {
                width: min(parent.width - 32px, 560px); height: 430px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                draft: root.ntfs-draft;
                save(data) => { root.ntfs-apply(data); }
                close => { root.action("close-dialog"); }
            }
        }
        if root.dialog-kind != "" && root.dialog-kind != "ntfs-options" && root.dialog-kind != "text-comparison" && root.dialog-kind != "transfer-conflict" && root.dialog-kind != "advanced-search" && root.dialog-kind != "sync-options" && root.dialog-kind != "sync-review" && root.dialog-kind != "ftp-browser" && root.dialog-kind != "ftp-profiles" && root.dialog-kind != "plugins" : Rectangle {
            background: #050a14a8;
            width: 100%; height: 100%;
            TouchArea { }
            dialog-card := Rectangle {
                property <int> revision: root.dialog-revision;
                property <bool> tall: root.dialog-kind == "text" || root.dialog-kind == "viewer" || root.dialog-kind == "image" || root.dialog-kind == "review" || root.dialog-kind == "search-results" || root.dialog-kind == "print-preview" || root.dialog-kind == "multiline";
                property <bool> rename: root.dialog-kind == "multi-rename";
                width: min(parent.width - 46px, tall ? 1000px : rename ? 760px : 650px);
                height: tall ? parent.height - 74px : rename ? min(parent.height - 26px, 420px) : 330px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                border-width: 1px;
                border-color: Colors.accent;
                background: Colors.panel;
                function submit-rename() {
                    root.submit-multi-rename(input.text, extension.text, {
                        find: rename-find.text,
                        replacement: rename-replacement.text,
                        regex: rename-regex.checked,
                        wildcards: rename-wildcards.checked,
                        match-case: rename-case.checked,
                        first-only: rename-first.checked,
                        include-extension: rename-suffix.checked,
                        substitute: rename-whole.checked,
                    });
                }
                card := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.dialog-title; color: Colors.text; font-size: 20px; font-weight: 700; overflow: elide; }
                    Text { text: root.dialog-description; color: Colors.muted; wrap: word-wrap; }
                    if root.dialog-kind == "viewer" : VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 5px;
                            search := LineEdit {
                                placeholder-text: root.viewer-mode == "hex" ? @tr("Hexbytes suchen") : @tr("Text suchen");
                                enabled: !root.job-active;
                                accepted => { root.viewer-control(2, self.text, 0); }
                            }
                            Button { text: @tr("Suchen"); enabled: !root.job-active && search.text != ""; clicked => { root.viewer-control(2, search.text, 0); } }
                            Button { text: @tr("Ab Anfang"); enabled: !root.job-active && search.text != ""; clicked => { root.viewer-control(3, search.text, 0); } }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            ComboBox {
                                model: ["Automatische Kodierung", "UTF-8", "UTF-16LE", "UTF-16BE", "Windows-1252"];
                                current-index: root.viewer-encoding;
                                enabled: !root.job-active && root.viewer-mode != "hex";
                                accessible-label: "Textkodierung";
                                selected => { root.viewer-control(0, "", self.current-index); }
                            }
                            position := LineEdit {
                                placeholder-text: "Byte-Offset, z. B. 1024 oder 0x400";
                                enabled: !root.job-active;
                                accepted => { root.viewer-control(1, self.text, 0); }
                            }
                            Button { text: @tr("Springen"); enabled: !root.job-active && position.text != ""; clicked => { root.viewer-control(1, position.text, 0); } }
                        }
                    }
                    input := LineEdit {
                        visible: root.dialog-kind == "input" || root.dialog-kind == "multi-rename";
                        text: root.dialog-value;
                        placeholder-text: root.dialog-placeholder;
                        accessible-label: root.dialog-placeholder;
                        input-type: root.dialog-secret ? password : text;
                        edited => { if dialog-card.rename { root.rename-edited(); } }
                        accepted => {
                            if dialog-card.rename { dialog-card.submit-rename(); }
                            else { root.submit(self.text, second.text, options.current-index); }
                        }
                    }
                    extension := LineEdit {
                        visible: dialog-card.rename && root.rename-separate;
                        text: root.rename-extension;
                        placeholder-text: @tr("Erweiterungsmaske");
                        accessible-label: @tr("Erweiterungsmaske");
                        edited => { root.rename-edited(); }
                        accepted => { dialog-card.submit-rename(); }
                    }
                    second := LineEdit {
                        visible: (root.dialog-kind == "input" || root.dialog-kind == "buttonbar-edit") && root.dialog-second-placeholder != "";
                        text: root.dialog-second;
                        placeholder-text: root.dialog-second-placeholder;
                        accessible-label: root.dialog-second-placeholder;
                        input-type: root.dialog-second-secret ? password : text;
                        accepted => {
                            if root.dialog-kind == "input" { root.submit(input.text, self.text, options.current-index); }
                        }
                    }
                    rename-find := LineEdit {
                        visible: dialog-card.rename;
                        text: root.rename-search.find;
                        placeholder-text: @tr("Suchen nach (optional)");
                        accessible-label: @tr("Suchen nach (optional)");
                        edited => { root.rename-edited(); }
                        accepted => { dialog-card.submit-rename(); }
                    }
                    rename-replacement := LineEdit {
                        visible: dialog-card.rename;
                        text: root.rename-search.replacement;
                        placeholder-text: @tr("Ersetzen durch");
                        accessible-label: @tr("Ersetzen durch");
                        edited => { root.rename-edited(); }
                        accepted => { dialog-card.submit-rename(); }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        rename-regex := CheckBox {
                            visible: dialog-card.rename;
                            text: @tr("Regulärer Ausdruck");
                            checked: root.rename-search.regex;
                            toggled => { root.rename-edited(); }
                        }
                        rename-case := CheckBox {
                            visible: dialog-card.rename;
                            text: @tr("Schreibweise beachten");
                            checked: root.rename-search.match-case;
                            toggled => { root.rename-edited(); }
                        }
                        rename-first := CheckBox {
                            visible: dialog-card.rename;
                            text: @tr("Nur erster Treffer");
                            checked: root.rename-search.first-only;
                            toggled => { root.rename-edited(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        rename-suffix := CheckBox {
                            visible: dialog-card.rename && root.rename-separate;
                            text: @tr("Erweiterung einbeziehen");
                            checked: root.rename-search.include-extension;
                            toggled => { root.rename-edited(); }
                        }
                        rename-whole := CheckBox {
                            visible: dialog-card.rename;
                            text: @tr("Ganzen Namen ersetzen");
                            checked: root.rename-search.substitute;
                            toggled => { root.rename-edited(); }
                        }
                        rename-wildcards := CheckBox {
                            visible: dialog-card.rename;
                            enabled: !rename-regex.checked;
                            text: @tr("Platzhalter * und ?");
                            checked: root.rename-search.wildcards;
                            toggled => { root.rename-edited(); }
                        }
                    }
                    options := ComboBox {
                        visible: root.dialog-options.length > 0;
                        model: root.dialog-options;
                        current-index: 0;
                        accessible-label: "Option";
                    }
                    if root.dialog-transfer-filters.length > 0 : ComboBox {
                        model: root.dialog-transfer-filters;
                        current-index <=> root.dialog-transfer-filter;
                        accessible-label: "Gespeicherter Suchfilter";
                    }
                    if root.dialog-kind == "text" || root.dialog-kind == "viewer" || root.dialog-kind == "review" || root.dialog-kind == "search-results" || root.dialog-kind == "print-preview" : TextEdit {
                        text: root.dialog-value;
                        read-only: true;
                        vertical-stretch: 1;
                        font-family: "Consolas";
                        accessible-label: @tr("Inhalt");
                    }
                    editor := TextEdit {
                        visible: root.dialog-kind == "multiline" || root.dialog-kind == "buttonbar-edit";
                        text: root.dialog-value;
                        vertical-stretch: 1;
                        font-family: "Consolas";
                        accessible-label: root.dialog-title;
                    }
                    if root.dialog-kind == "image" : Image {
                        source: root.viewer-image;
                        image-fit: contain;
                        vertical-stretch: 1;
                        accessible-label: root.dialog-title;
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        if root.dialog-kind == "viewer" : Button { text: @tr("Zurück"); enabled: root.viewer-back; clicked => { root.action("viewer-back"); } }
                        if root.dialog-kind == "viewer" : Button { text: @tr("Weiter"); enabled: root.viewer-next; clicked => { root.action("viewer-next"); } }
                        if root.dialog-kind == "viewer" : Button { text: "Drucken …"; clicked => { root.action("print-file"); } }
                        if root.dialog-kind == "viewer" : Button { text: root.viewer-mode == "hex" ? "Text" : "Hex"; clicked => { root.action("viewer-toggle"); } }
                        if root.dialog-kind == "viewer" || root.dialog-kind == "image" : Button { text: @tr("Eigenes Fenster"); enabled: !root.job-active; clicked => { root.action("viewer-detach"); } }
                        if root.dialog-kind == "text" || root.dialog-kind == "viewer" || root.dialog-kind == "search-results" : Button { text: @tr("Text kopieren"); clicked => { root.action("copy-result"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: root.dialog-kind == "text" || root.dialog-kind == "viewer" || root.dialog-kind == "image" ? @tr("Schließen") : @tr("Abbrechen"); clicked => { root.action("close-dialog"); } }
                        if root.dialog-kind == "input" || root.dialog-kind == "confirm" || root.dialog-kind == "review" || root.dialog-kind == "search-results" || root.dialog-kind == "print-preview" : Button {
                            text: root.dialog-kind == "search-results" ? "Treffer übernehmen" : (root.dialog-kind == "print-preview" ? "Drucken …" : @tr("Ausführen"));
                            clicked => { root.submit(input.text, second.text, options.current-index); }
                            init => { if (root.dialog-kind != "input") { self.focus(); } }
                        }
                        if root.dialog-kind == "multiline" || root.dialog-kind == "buttonbar-edit" : Button {
                            text: @tr("Speichern");
                            clicked => { root.submit(editor.text, root.dialog-kind == "buttonbar-edit" ? second.text : "", 0); }
                        }
                        if root.dialog-kind == "multi-rename" : Button {
                            text: @tr("Vorschau");
                            clicked => { dialog-card.submit-rename(); }
                        }
                    }
                }
                init => {
                    if (root.dialog-kind == "input" || root.dialog-kind == "multi-rename") { input.focus(); }
                    if (root.dialog-kind == "multiline" || root.dialog-kind == "buttonbar-edit") { editor.focus(); }
                }
                changed revision => {
                    input.text = root.dialog-value;
                    second.text = root.dialog-second;
                    extension.text = root.rename-extension;
                    rename-find.text = root.rename-search.find;
                    rename-replacement.text = root.rename-search.replacement;
                    rename-regex.checked = root.rename-search.regex;
                    rename-wildcards.checked = root.rename-search.wildcards;
                    rename-case.checked = root.rename-search.match-case;
                    rename-first.checked = root.rename-search.first-only;
                    rename-suffix.checked = root.rename-search.include-extension;
                    rename-whole.checked = root.rename-search.substitute;
                    options.current-index = 0;
                    editor.text = root.dialog-value;
                    if (root.dialog-kind == "input" || root.dialog-kind == "multi-rename") { input.focus(); }
                    if (root.dialog-kind == "multiline" || root.dialog-kind == "buttonbar-edit") { editor.focus(); }
                }
            }
        }
    }
}
