                            LineEdit {
                                text <=> content.extra;
                                accessible-label: root.dialog-second-placeholder;
                                input-type: root.dialog-second-secret ? password : text;
                            }
                        }
                        if root.dialog-options.length > 0 : VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: root.dialog-options-label == "" ? @tr("Auswahl") : root.dialog-options-label; }
                            ComboBox {
                                property <int> cycle: root.dialog-focus-cycle;
                                changed cycle => { if (self.cycle > 0) { self.focus(); } }
                                model: root.dialog-options;
                                current-index <=> content.choice;
                                accessible-label: root.dialog-options-label == "" ? @tr("Auswahl") : root.dialog-options-label;
                            }
                        }
                        if dialog-card.document && root.dialog-value != "" : TextEdit {
                            text: root.dialog-value;
                            read-only: true;
                            height: min(min(root.height / 2, 430px), max(65px, root.dialog-content-lines * 18px + 24px));
                            font-family: "Consolas";
                            accessible-label: @tr("Inhalt");
                        }
                        if root.dialog-kind == "delete" : TextEdit {
                            height: min(120px, max(52px, root.dialog-content-lines * 18px + 24px));
                            read-only: true;
                            wrap: no-wrap;
                            text: root.dialog-value;
                            accessible-label: @tr("Ausgewählte Einträge");
                        }
                        if dialog-card.editable : TextEdit {
                            property <int> cycle: root.dialog-focus-cycle;
                            changed cycle => { if (self.cycle > 0) { self.focus(); } }
                            text <=> content.body;
                            height: min(290px, root.height / 2);
                            font-family: "Consolas";
                            accessible-label: root.dialog-title;
                            init => { self.focus(); }
                        }
                        Rectangle { height: 1px; background: Colors.edge; }
                        HorizontalLayout {
                            spacing: 7px;
                            if root.dialog-kind == "text" || root.dialog-kind == "search-results" : Button { text: @tr("Text kopieren"); clicked => { root.action("copy-result"); } }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                property <int> cycle: root.dialog-focus-cycle;
                                changed cycle => {
                                    if ((self.cycle > 0 && !dialog-card.editable && root.dialog-options.length == 0)
                                        || (self.cycle < 0 && root.dialog-kind == "text")) { self.focus(); }
                                }
                                text: root.dialog-kind == "text" ? @tr("Schließen") : @tr("Abbrechen");
                                clicked => { root.action("close-dialog"); }
                                init => { if (root.dialog-kind == "delete" || root.dialog-kind == "text") { self.focus(); } }
                            }
                            if root.dialog-kind == "delete" || root.dialog-kind == "review" || root.dialog-kind == "search-results" || root.dialog-kind == "print-preview" : Button {
                                property <int> cycle: root.dialog-focus-cycle;
                                changed cycle => { if (self.cycle < 0) { self.focus(); } }
                                text: root.dialog-confirm-label != "" ? root.dialog-confirm-label : root.dialog-kind == "search-results" ? @tr("Treffer übernehmen") : (root.dialog-kind == "print-preview" ? @tr("Drucken …") : @tr("Bestätigen"));
                                primary: root.dialog-kind != "delete";
                                destructive: root.dialog-kind == "delete";
                                clicked => { root.submit(root.dialog-value, content.extra, content.choice); }
                                init => { if (root.dialog-kind != "delete") { self.focus(); } }
                            }
                            if dialog-card.editable : Button {
                                property <int> cycle: root.dialog-focus-cycle;
                                changed cycle => { if (self.cycle < 0) { self.focus(); } }
                                text: @tr("Speichern");
                                primary: true;
                                clicked => { root.submit(content.body, root.dialog-kind == "buttonbar-edit" ? content.extra : "", 0); }
                            }
                        }
                    }
                }
            }
        }
        FocusBoundary {
            enabled: root.modal-open;
            reached => { root.dialog-focus-cycle = max(0, root.dialog-focus-cycle) + 1; }
        }
    }
}
