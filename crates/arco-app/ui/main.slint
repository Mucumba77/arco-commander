import { ComboBox, LineEdit, ListView, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { Colors, Button, CheckBox, NavButton, ActionButton, DetailCell, FocusBoundary } from "dialog-theme.slint";
import { DialogHeading, FieldLabel, FileOperationCard, ReaderPane, ImagePane, TransferManagerCard, TransferManagerData, CompactDialogCard, ProgressRail, TransferProgressCard, JobMetrics, OperationKind, FormSection, ProgressMeter, ProgressMetrics, ReviewRow, ReviewTable, ReviewCard } from "operation-dialogs.slint";
export { JobMetrics, OperationKind, ReviewRow } from "operation-dialogs.slint";
export { Colors } from "dialog-theme.slint";
export { TransferManagerData } from "operation-dialogs.slint";

export struct CommandRow { key: string, label: string, menu-label: string, icon: image, shortcut: string }
export struct MenuSection { title: string, icon: image, rows: [CommandRow] }
export struct MenuCategory { title: string, primary: [CommandRow], sections: [MenuSection] }

export struct FileRow {
    comment: string,
    name: string,
    full-name: string,
    extension: string,
    info: string,
    time: string,
    attributes: string,
    icon: string,
    thumbnail: image,
    has-thumbnail: bool,
    selected: bool,
    wdx-values: [string],
    expression-values: [string],
    custom-color: bool,
    light-color: color,
    dark-color: color,
}

export struct PathItem {
    label: string,
    path: string,
    locked: bool,
    has-tint: bool,
    tint: color,
}

export struct TreeRow {
    title: string,
    path: string,
    depth: int,
    expandable: bool,
    expanded: bool,
}

export struct TreeData {
    rows: [TreeRow],
    cursor: int,
    shown: bool,
    focused: bool,
}

export struct ButtonbarRow {
    label: string,
    icon: string,
    custom-icon: image,
}

export struct FileConflictData {
    manual-index: int,
    source: string,
    target: string,
    source-info: string,
    target-info: string,
    source-preview: string,
    target-preview: string,
}

export struct NtfsDraft {
    streams: bool,
    permissions: bool,
    owner: bool,
    audit: bool,
    hardlinks: bool,
    sparse: bool,
    creation-time: bool,
    copy-links: bool,
}

export struct DiffData {
    binary: bool,
    left-path: string,
    right-path: string,
    left-range: string,
    right-range: string,
    left-text: string,
    right-text: string,
    summary: string,
    editable-left: bool,
    editable-right: bool,
    has-previous: bool,
    has-next: bool,
    has-change: bool,
    ignore-case: bool,
    ignore-whitespace: bool,
    ignore-line-endings: bool,
}

export struct FileColumn {
    title: string,
    key: string,
    action: string,
    width: int,
    wdx-index: int,
    expression-index: int,
    right-aligned: bool,
}

export struct PanelData {
    path: string,
    rows: [FileRow],
    tabs: [PathItem],
    crumbs: [PathItem],
    tab: int,
    filter: string,
    has-primary: bool,
    has-secondary: bool,
    primary: color,
    secondary: color,
    primary-ink: color,
    secondary-ink: color,
    detailed: bool,
    thumbnails: bool,
    comments: bool,
    sort-column: string,
    wdx-sort-index: int,
    descending: bool,
    volume: string,
    drive: string,
    local: bool,
    custom-columns: [FileColumn],
    custom-width: int,
    custom-extension: bool,
    wdx-headings: [string],
}

export struct SettingsData {
    toolbar: bool,
    panel-toolbar: bool,
    drive-buttons: bool,
    drive-list: bool,
    folder-tabs: bool,
    current-path: bool,
    breadcrumbs: bool,
    history-buttons: bool,
    column-headers: bool,
    panel-status: bool,
    command-line: bool,
    function-keys: bool,
    numpad-folders: bool,
    quick-find-start: int,
    stacked: bool,
    light: bool,
    system-theme: bool,
    show-hidden: bool,
    list-font: int,
    list-font-size: int,
    language: int,
    editor: string,
    everything: string,
    transfer-rate: string,
    transfer-log: string,
    transfer-comments: bool,
    ntfs: NtfsDraft,
}

global Typography {
    public pure function family(choice: int) -> string {
        return choice == 1 ? "Arial" : choice == 2 ? "Verdana" : "Segoe UI";
    }
    public pure function size(choice: int) -> length {
        return choice == 0 ? 12px : choice == 2 ? 16px : choice == 3 ? 18px : 14px;
    }
}

export struct SyncOptionsData {
    mode: int,
    recursive: bool,
    empty-dirs: bool,
    selected-only: bool,
    by-content: bool,
    ignore-date: bool,
    masks: string,
    remember-roots: bool,
}

export struct SearchDraft {
    names: string,
    content: string,
    content-mode: int,
    encoding: int,
    match-case: bool,
    minimum-bytes: string,
    maximum-bytes: string,
    modified-from: string,
    modified-to: string,
    attributes: string,
    depth: string,
    roots: string,
    selected-only: bool,
    wdx-profile: string,
    archive-password: string,
}

component SearchCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { names.focus(); } else { search-button.focus(); } }
    in property <SearchDraft> draft;
    in property <string> base;
    in property <[string]> profiles;
    in property <[string]> wdx-profiles;
    in property <bool> archive;
    in property <string> notice;
    in property <bool> has-selection;
    callback configure(SearchDraft, string, int);
    callback close();
    background: Colors.panel;
    border-color: Colors.edge;
    border-width: 1px;
    border-radius: 16px;

    function values() -> SearchDraft {
        return { names: names.text, content: contents.text, content-mode: mode.current-index,
            encoding: encoding.current-index, match-case: match-case.checked,
            minimum-bytes: min-size.text, maximum-bytes: max-size.text,
            modified-from: from-date.text, modified-to: to-date.text,
            attributes: attrs.text, depth: depth.text, roots: roots.text, selected-only: selection.checked,
            wdx-profile: wdx-name.text, archive-password: root.archive ? archive-password.text : "" };
    }
    function reset() {
        names.text = root.draft.names;
        contents.text = root.draft.content;
        mode.current-index = root.draft.content-mode;
        encoding.current-index = root.draft.encoding;
        match-case.checked = root.draft.match-case;
        min-size.text = root.draft.minimum-bytes;
        max-size.text = root.draft.maximum-bytes;
        from-date.text = root.draft.modified-from;
        to-date.text = root.draft.modified-to;
        attrs.text = root.draft.attributes;
        depth.text = root.draft.depth;
        roots.text = root.draft.roots;
        selection.checked = root.draft.selected-only;
        wdx-name.text = root.draft.wdx-profile;
        archive-password.text = "";
    }
    init => { root.reset(); names.focus(); }
    changed draft => { root.reset(); }

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        DialogHeading { icon: @image-url("icons/search.svg"); title: @tr("Erweiterte Dateisuche"); subtitle: root.base; wrap-subtitle: false; }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalLayout {
                width: parent.visible-width;
                spacing: 8px;
                alignment: start;
                FormSection {
                    title: @tr("Dateiname und Inhalt");
                names := LineEdit { placeholder-text: "Dateimasken, z. B. *.txt;*.md | *.bak oder ~RegEx"; accessible-label: "Dateinamensmuster"; }
                Text { text: "Everything-Präfixe: ev: für den gesamten Index und ed: für die Suchorte."; color: Colors.muted; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 6px;
                    mode := ComboBox { model: ["Jeder Inhalt", "Text", "Regulärer Ausdruck", "Hex"]; width: 160px; accessible-label: "Art der Inhaltssuche"; }
                    contents := LineEdit { placeholder-text: "Suchtext oder Hex-Bytes"; enabled: mode.current-index > 0; }
                    encoding := ComboBox { model: ["Automatisch", "UTF-8", "UTF-16 LE", "UTF-16 BE", "Windows-1252"]; enabled: mode.current-index == 1 || mode.current-index == 2; width: 130px; accessible-label: "Textkodierung"; }
                }
                match-case := CheckBox { text: "Groß- und Kleinschreibung bei Text und RegEx beachten"; }
                }
                FormSection {
                    title: @tr("Größe, Datum und Attribute");
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Mindestens Bytes"); } min-size := LineEdit { placeholder-text: @tr("Mindestens Bytes"); accessible-label: @tr("Mindestens Bytes"); } }
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Höchstens Bytes"); } max-size := LineEdit { placeholder-text: @tr("Höchstens Bytes"); accessible-label: @tr("Höchstens Bytes"); } }
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Attribute, z. B. +r -hs"); } attrs := LineEdit { placeholder-text: @tr("Attribute, z. B. +r -hs"); accessible-label: @tr("Attribute, z. B. +r -hs"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Ab JJJJ-MM-TT"); } from-date := LineEdit { placeholder-text: @tr("Ab JJJJ-MM-TT"); accessible-label: @tr("Ab JJJJ-MM-TT"); } }
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Bis JJJJ-MM-TT"); } to-date := LineEdit { placeholder-text: @tr("Bis JJJJ-MM-TT"); accessible-label: @tr("Bis JJJJ-MM-TT"); } }
                    VerticalLayout { spacing: 4px; FieldLabel { text: @tr("Unterordnerebenen, 0 für keine"); } depth := LineEdit { placeholder-text: @tr("Unterordnerebenen, 0 für keine"); accessible-label: @tr("Unterordnerebenen, 0 für keine"); } }
                }
                }
                FormSection {
                    title: @tr("Suchorte");
                selection := CheckBox { text: "Nur markierte Dateien und Ordner durchsuchen"; enabled: root.has-selection; }
                Text { text: root.archive ? "Je Zeile ein relativer Archivpfad. Leer sucht ab dem geöffneten Archivordner." : "Je Zeile ein Pfad. Leer sucht im aktiven Ordner."; color: Colors.muted; wrap: word-wrap; }
                roots := TextEdit { min-height: 68px; max-height: 90px; enabled: !selection.checked; accessible-label: @tr("Suchorte"); }
                archive-password := LineEdit {
                    visible: root.archive;
                    input-type: password;
                    placeholder-text: "Archivpasswort für Inhaltssuche (optional)";
                    accessible-label: "Archivpasswort";
                }
                }
                FormSection {
                    title: @tr("WDX-Feldbedingungen");
                HorizontalLayout {
                    spacing: 6px;
                    wdx-name := LineEdit { placeholder-text: "Name des WDX-Suchprofils"; }
                    wdx-list := ComboBox { model: root.wdx-profiles; enabled: root.wdx-profiles.length > 0; accessible-label: @tr("WDX-Suchprofile"); }
                    Button { text: "Auswählen"; enabled: root.wdx-profiles.length > 0; clicked => { wdx-name.text = wdx-list.current-value; } }
                }
                }
                FormSection {
                    title: @tr("Suchprofile");
                HorizontalLayout {
                    spacing: 6px;
                    saved := ComboBox { model: root.profiles; accessible-label: "Gespeicherte Suchprofile"; }
                    Button { text: "Laden"; enabled: root.profiles.length > 0; clicked => { root.configure(root.values(), saved.current-value, 0); } }
                    Button { text: @tr("Entfernen"); destructive: true; enabled: root.profiles.length > 0; clicked => { root.configure(root.values(), saved.current-value, 3); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    profile-name := LineEdit { placeholder-text: "Profilname"; }
                    Button { text: "Profil speichern"; clicked => { root.configure(root.values(), profile-name.text, 1); } }
                }
                }
            }
        }
        Text { text: root.notice; color: Colors.accent; wrap: word-wrap; visible: root.notice != ""; }
        HorizontalLayout {
            spacing: 7px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Abbrechen"); clicked => { root.close(); } }
            search-button := Button { text: @tr("Suchen"); icon: @image-url("icons/search.svg"); primary: true; clicked => { root.configure(root.values(), "", 2); } }
        }
    }
}

export component SearchWindow inherits Window {
    title: @tr("Arco Commander · Dateisuche");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: 820px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 540px;
    background: Colors.background;
    property <ColorScheme> scheme: Colors.light ? ColorScheme.light : ColorScheme.dark;
    init => { Palette.color-scheme = root.scheme; }
    changed scheme => { Palette.color-scheme = root.scheme; }
    in property <SearchDraft> draft;
    in property <string> base;
    in property <string> working-base;
    in property <[string]> profiles;
    in property <[string]> wdx-profiles;
    in property <bool> archive;
    in property <string> notice;
    in property <bool> has-selection;
    in property <bool> busy;
    in property <bool> cancelling;
    in property <JobMetrics> metrics;
    in-out property <bool> has-result;
    in property <bool> can-use;
    in property <string> result-title;
    in property <string> result-list;
    in property <[ReviewRow]> result-rows;
    callback configure(SearchDraft, string, int);
    callback cancel-search();
    callback use-results();
    callback close-search();
    callback copy-text(string);
    FocusScope {
        width: 100%; height: 100%; focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if (root.busy) { root.cancel-search(); } else { root.close-search(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 12px; spacing: 12px;
            if !root.busy && !root.has-result : SearchCard {
                draft: root.draft; base: root.base; profiles: root.profiles; wdx-profiles: root.wdx-profiles;
                archive: root.archive; notice: root.notice; has-selection: root.has-selection;
                configure(data, name, operation) => { root.configure(data, name, operation); }
                close => { root.close-search(); }
            }
            if root.busy : Rectangle {
                background: Colors.panel; border-radius: 16px; border-color: Colors.edge; border-width: 1px;
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    DialogHeading { icon: @image-url("icons/search.svg"); title: @tr("Dateisuche"); subtitle: root.cancelling ? @tr("Abbruch angefordert …") : root.metrics.phase; }
                    Text { text: root.working-base; color: Colors.muted; overflow: elide; Tooltip { text: @markdown("\{root.working-base}"); } }
                    ProgressMeter { label: @tr("Suchfortschritt"); progress: -1; paused: root.cancelling; }
                    ProgressMetrics { kind: OperationKind.search; data: root.metrics; }
                    FieldLabel { text: @tr("Aktueller Pfad"); }
                    Text { text: root.metrics.source; color: Colors.text; overflow: elide; Tooltip { text: @markdown("\{root.metrics.source}"); } }
                    if root.metrics.errors != "" && root.metrics.errors != "0" : Text { text: @tr("Lesefehler") + ": " + root.metrics.errors; color: Colors.archive; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Schließen"); clicked => { root.close-search(); } }
                        Button { text: @tr("Suchlauf abbrechen"); enabled: !root.cancelling; destructive: true; clicked => { root.cancel-search(); } init => { self.focus(); } }
                    }
                }
            }
            if !root.busy && root.has-result : ReviewCard {
                kind: OperationKind.search; title: root.result-title; description: root.working-base;
                rows: root.result-rows; primary-label: @tr("Name"); secondary-label: @tr("Typ / Größe");
                confirm-label: @tr("Treffer übernehmen"); can-confirm: root.can-use; can-edit: true;
                confirm(choice) => { root.use-results(); }
                edit => { root.has-result = false; }
                close => { root.close-search(); }
                copy-all => { root.copy-text(root.result-list); }
                copy-row(text) => { root.copy-text(text); }
            }
            if !root.busy && root.has-result && root.notice != "" : Text { text: root.notice; color: Colors.archive; wrap: word-wrap; }
        }
    }
}

export struct SyncRowData {
    index: int, path: string, left: string, right: string, comparison: string,
    action: int, can-left: bool, can-right: bool, can-delete: bool,
}

export struct FtpRowData { name: string, info: string, modified: string, directory: bool }

export struct FtpProfileData {
    name: string,
    address: string,
    user: string,
    proxy: string,
    local-directory: string,
    security: int,
    active: bool,
    listing: int,
    remember: bool,
}

export struct PluginRowData {
    name: string,
    kind: string,
    architecture: string,
    enabled: bool,
    masks: string,
    path: string,
    detection: string,
}

component FtpProfilesCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { profile-list.focus(); } else if (connect-button.enabled) { connect-button.focus(); } else { save-button.focus(); } }
    in property <[string]> profiles;
    in property <int> selected;
    in property <FtpProfileData> data;
    in property <int> revision;
    in property <string> notice;
    in property <bool> busy;
    property <bool> dirty: name.text != root.data.name || address.text != root.data.address
        || user.text != root.data.user || proxy.text != root.data.proxy || local.text != root.data.local-directory
        || security.current-index != root.data.security || active.checked != root.data.active
        || listing.current-index != root.data.listing || remember.checked != root.data.remember || password-field.text != "";
    callback select(int);
    callback operate(string, FtpProfileData, string);
    callback close();
    background: Colors.panel;
    border-radius: 16px; border-width: 1px; border-color: Colors.edge;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        DialogHeading { icon: @image-url("icons/network.svg"); title: @tr("FTP-Verbindungen"); subtitle: @tr("Verbindung auswählen oder ein neues Profil anlegen."); }
        HorizontalLayout {
            spacing: 8px;
            profile-list := ComboBox {
                model: root.profiles; enabled: !root.busy;
                current-index: root.selected;
                accessible-label: @tr("Gespeicherte FTP-Verbindungen");
                horizontal-stretch: 1;
                selected => { root.select(self.current-index); }
            }
            Button { text: @tr("Neu"); icon: @image-url("icons/folderplus.svg"); enabled: !root.busy; clicked => { root.select(0); } }
            Button { text: @tr("Importieren"); icon: @image-url("icons/archive-extract.svg"); enabled: !root.busy; clicked => { root.operate("import", root.data, ""); } }
        }
        Rectangle { height: 1px; background: Colors.edge; }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalLayout {
                width: parent.visible-width;
                spacing: 10px; alignment: start;
                FormSection { title: @tr("Server und Profil");
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            FieldLabel { text: @tr("Profilname"); }
                            name := LineEdit { text: root.data.name; accessible-label: @tr("Profilname"); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 4px;
                            FieldLabel { text: @tr("FTP-Adresse und Startordner"); }
                            address := LineEdit { text: root.data.address; placeholder-text: "ftp://server:port/startordner/"; accessible-label: @tr("FTP-Adresse und Startordner"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("Verschlüsselungsmodus"); }
                            security := ComboBox {
                                model: [@tr("Explizites FTPS (FTP mit TLS)"), @tr("Implizites FTPS"), @tr("Klartext-FTP")];
                                current-index: root.data.security;
                                accessible-label: @tr("Verschlüsselungsmodus");
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("Format der Verzeichnisliste"); }
                            listing := ComboBox {
                                model: [@tr("Automatisch"), @tr("Nur MLSD"), @tr("Nur LIST (Unix / IIS)")];
                                current-index: root.data.listing;
                                accessible-label: @tr("Format der Verzeichnisliste");
                            }
                        }
                    }
                    Text {
                        text: security.current-index == 2
                            ? @tr("Klartext-FTP überträgt Passwort und Dateien unverschlüsselt.")
                            : security.current-index == 1 ? @tr("Für implizites FTPS ftps:// verwenden.") : @tr("Für explizites FTPS ftp:// verwenden.");
                        color: security.current-index == 2 ? Colors.archive : Colors.muted;
                        wrap: word-wrap;
                    }
                }
                FormSection { title: @tr("Übertragungsoptionen");
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("Lokaler Startordner"); }
                            local := LineEdit { text: root.data.local-directory; placeholder-text: @tr("Absoluter Pfad (optional)"); accessible-label: @tr("Lokaler Startordner"); }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("Proxy"); }
                            proxy := LineEdit { text: root.data.proxy; placeholder-text: @tr("HTTP-/SOCKS-Proxy (optional)"); accessible-label: @tr("Proxy"); }
                        }
                    }
                    active := CheckBox { text: @tr("Aktiver FTP-Modus (Direktverbindung)"); checked: root.data.active; }
                }
                FormSection { title: @tr("Anmeldung");
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("Benutzername"); }
                            user := LineEdit { text: root.data.user; placeholder-text: @tr("Leer für anonyme Anmeldung"); accessible-label: @tr("Benutzername"); }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: @tr("FTP-Passwort"); }
                            password-field := LineEdit {
                                placeholder-text: root.data.remember ? @tr("Neues Passwort (optional)") : @tr("Passwort zum Speichern");
                                input-type: password;
                                enabled: remember.checked;
                                accessible-label: @tr("FTP-Passwort");
                            }
                        }
                    }
                    remember := CheckBox { text: @tr("Passwort in Windows-Anmeldeinformationen speichern"); checked: root.data.remember; }
                }
            }
        }
        if root.notice != "" : Text { text: root.notice; wrap: word-wrap; color: Colors.text; }
        Rectangle { height: 1px; background: Colors.edge; }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: @tr("Löschen"); destructive: true; icon: @image-url("icons/trash.svg");
                enabled: root.selected > 0 && !root.busy;
                clicked => { root.operate("delete", root.data, ""); }
            }
            Text { text: root.dirty ? @tr("Ungespeicherte Änderungen") : @tr("Profil unverändert"); overflow: elide; min-width: 0px; color: root.dirty ? Colors.archive : Colors.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: @tr("Schließen"); clicked => { root.close(); } }
            save-button := Button {
                text: @tr("Speichern"); enabled: root.dirty && !root.busy && name.text != "" && address.text != "";
                clicked => {
                    root.operate("save", {
                        name: name.text, address: address.text, user: user.text, proxy: proxy.text,
                        local-directory: local.text,
                        security: security.current-index, active: active.checked, remember: remember.checked,
                        listing: listing.current-index,
                    }, password-field.text);
                }
            }
            connect-button := Button {
                text: root.dirty || root.selected == 0 ? @tr("Speichern & verbinden") : @tr("Verbinden");
                icon: @image-url("icons/network.svg"); primary: true;
                enabled: !root.busy && name.text != "" && address.text != "";
                clicked => {
                    if (root.dirty || root.selected == 0) {
                        root.operate("save-connect", {
                            name: name.text, address: address.text, user: user.text, proxy: proxy.text,
                            local-directory: local.text, security: security.current-index,
                            active: active.checked, remember: remember.checked, listing: listing.current-index,
                        }, password-field.text);
                    } else { root.operate("connect", root.data, ""); }
                }
            }
        }
    }

    changed revision => {
        profile-list.current-index = root.selected;
        name.text = root.data.name;
        address.text = root.data.address;
        user.text = root.data.user;
        proxy.text = root.data.proxy;
        local.text = root.data.local-directory;
        security.current-index = root.data.security;
        active.checked = root.data.active;
        listing.current-index = root.data.listing;
        remember.checked = root.data.remember;
        password-field.text = "";
        if (root.selected == 0) { name.focus(); }
    }
    init => { name.focus(); }
}

export struct ShortcutRow { key: string, label: string }
struct PanelAction { icon: image, label: string, command: string }
export struct ShortcutLabels {
    refresh: string,
    view: string,
    edit: string,
    copy: string,
    move-file: string,
    mkdir: string,
    delete: string,
    palette: string,
    job-details: string,
}

component CustomBarButton inherits NavButton {
    in property <string> icon-name;
    in property <image> custom-icon;
    property <bool> has-custom-icon: root.custom-icon.width > 0;
    colorize-icon: !root.has-custom-icon;
    icon: root.has-custom-icon ? root.custom-icon
        : root.icon-name == "ordner" ? @image-url("icons/folder.svg")
        : root.icon-name == "suche" ? @image-url("icons/search.svg")
        : root.icon-name == "kopieren" ? @image-url("icons/copy.svg")
        : root.icon-name == "verschieben" ? @image-url("icons/move.svg")
        : root.icon-name == "archiv" ? @image-url("icons/archive.svg")
        : root.icon-name == "netz" ? @image-url("icons/network.svg")
        : root.icon-name == "terminal" ? @image-url("icons/terminal.svg")
        : root.icon-name == "stern" ? @image-url("icons/star.svg")
        : root.icon-name == "einstellungen" ? @image-url("icons/settings.svg")
        : @image-url("icons/file.svg");
}

component CommandPaletteCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0 || root.rows.length == 0) { input.focus(); } else { execute-command.focus(); } }
    in property <[CommandRow]> rows;
    property <int> current: 0;
    callback query(string);
    callback pick(string);
    callback dismiss();
    background: Colors.panel;
    border-radius: 14px;
    border-color: Colors.edge;
    border-width: 1px;

    function select(index: int) {
        if (root.rows.length > 0) {
            root.current = min(max(index, 0), root.rows.length - 1);
            if (root.current * 34px < -results.viewport-y) {
                results.viewport-y = -root.current * 34px;
            } else if ((root.current + 1) * 34px > -results.viewport-y + results.visible-height) {
                results.viewport-y = results.visible-height - (root.current + 1) * 34px;
            }
        }
    }
    function run-current() {
        if (root.current >= 0 && root.current < root.rows.length) {
            root.pick(root.rows[root.current].key);
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.select(root.current - 1); return accept; }
            if (event.text == Key.DownArrow) { root.select(root.current + 1); return accept; }
            if (event.text == Key.Escape) { root.dismiss(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Image { source: @image-url("icons/search.svg"); width: 20px; height: 20px; colorize: Colors.accent; }
                Text { text: @tr("Befehlspalette"); color: Colors.text; font-size: 20px; font-weight: 650; }
                Rectangle { horizontal-stretch: 1; }
                NavButton { icon: @image-url("icons/close.svg"); label: @tr("Schließen"); clicked => { root.dismiss(); } }
            }
            input := LineEdit {
                placeholder-text: @tr("Befehl oder Tastenkürzel suchen …");
                accessible-label: self.placeholder-text;
                edited(text) => { root.current = 0; results.viewport-y = 0px; root.query(text); }
                accepted => { root.run-current(); }
            }
            results := ListView {
                vertical-stretch: 1;
                accessible-label: @tr("Gefundene Befehle");
                for row[i] in root.rows : Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: i == root.current || hit.has-hover ? Colors.selection : transparent;
                    accessible-role: button;
                    accessible-label: row.label + (row.shortcut == "" ? "" : " · " + row.shortcut);
                    accessible-action-default => { root.pick(row.key); }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 10px;
                        spacing: 9px;
                        Image { source: row.icon; width: 17px; height: 17px; colorize: Colors.accent; }
                        DetailCell { text: row.label; color: Colors.text; font-size: 13px; horizontal-stretch: 1; }
                        DetailCell { text: row.shortcut; }
                    }
                    hit := TouchArea { clicked => { root.pick(row.key); } }
                }
            }
            if root.rows.length == 0 : DetailCell { text: @tr("Keine passenden Befehle."); }
            HorizontalLayout {
                DetailCell { text: @tr("↑ ↓ Auswählen · Enter Ausführen · Esc Schließen"); horizontal-stretch: 1; }
                execute-command := Button { text: @tr("Ausführen"); primary: true; enabled: root.rows.length > 0; clicked => { root.run-current(); } }
            }
        }
        init => { input.focus(); }
    }
}

component PluginManagerCard inherits Rectangle {
    changed selection => { if (root.selection >= 0) { root.choose(root.selection); } }
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { filter-input.focus(); } else { plugin-close.focus(); } }
    in property <[PluginRowData]> entries;
    in-out property <int> selection: -1;
    in property <string> query;
    changed query => { filter-input.text = root.query; }
    in property <string> notice;
    in property <int> total;
    in property <bool> busy;
    property <bool> selected: root.selection >= 0 && root.selection < root.entries.length;
    property <PluginRowData> item: root.selected ? root.entries[root.selection] : { name: "", kind: "", architecture: "", enabled: false, masks: "", path: "", detection: "" };
    callback filter(string);
    callback operate(string, int);
    callback close();
    function choose(index: int) {
        root.selection = clamp(index, 0, max(0, root.entries.length - 1));
        if (root.selection * 64px < -plugin-list.viewport-y) { plugin-list.viewport-y = -root.selection * 64px; }
        else if ((root.selection + 1) * 64px > -plugin-list.viewport-y + plugin-list.visible-height) { plugin-list.viewport-y = plugin-list.visible-height - (root.selection + 1) * 64px; }
    }
    background: Colors.panel; border-radius: 16px; border-width: 1px; border-color: Colors.edge;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        DialogHeading { icon: @image-url("icons/settings.svg"); title: @tr("Plugin-Verwaltung"); subtitle: @tr("Registrierung, Reihenfolge und Funktionen an einem Ort."); }
        HorizontalLayout {
            spacing: 8px;
            Button { text: @tr("DLL hinzufügen …"); icon: @image-url("icons/folderplus.svg"); enabled: !root.busy; clicked => { root.operate("add", -1); } }
            Button { text: @tr("ZIP installieren …"); icon: @image-url("icons/archive.svg"); enabled: !root.busy; clicked => { root.operate("package", -1); } }
            Button { text: @tr("TC importieren …"); icon: @image-url("icons/archive-extract.svg"); enabled: !root.busy; clicked => { root.operate("import", -1); } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            vertical-stretch: 1; spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 8px;
                HorizontalLayout { spacing: 6px;
                    filter-input := LineEdit { text: root.query; placeholder-text: @tr("Name, Typ, Maske oder Pfad filtern"); accessible-label: @tr("Plugins filtern"); edited(text) => { root.filter(text); } }
                    NavButton { icon: @image-url("icons/close.svg"); label: @tr("Filter leeren"); enabled: root.query != ""; clicked => { root.filter(""); } }
                }
                HorizontalLayout {
                    Text { text: "\{root.entries.length} / \{root.total}"; color: Colors.muted; vertical-alignment: center; horizontal-stretch: 1; }
                    NavButton { icon: @image-url("icons/up.svg"); label: @tr("Plugin nach oben"); enabled: root.selected && root.query == "" && root.selection > 0 && !root.busy; clicked => { root.operate("up", root.selection); } }
                    NavButton { icon: @image-url("icons/down.svg"); label: @tr("Plugin nach unten"); enabled: root.selected && root.query == "" && root.selection + 1 < root.entries.length && !root.busy; clicked => { root.operate("down", root.selection); } }
                }
                Rectangle {
                    border-radius: 9px; border-width: 1px; border-color: plugin-keys.has-focus ? Colors.accent : Colors.edge;
                    background: Colors.background; vertical-stretch: 1;
                    plugin-list := ListView {
                        width: parent.width; height: parent.height;
                        accessible-label: @tr("Registrierte Plugins in Ausführungsreihenfolge");
                        for entry[index] in root.entries : Rectangle {
                            height: 64px;
                            background: index == root.selection ? Colors.cursor : Math.mod(index, 2) == 0 ? Colors.background : Colors.surface;
                            accessible-role: list-item; accessible-label: entry.name + " · " + entry.kind + " · " + entry.architecture;
                            HorizontalLayout {
                                padding: 12px; spacing: 10px;
                                Image { source: entry.kind == "WCX" ? @image-url("icons/archive.svg") : entry.kind == "WFX" ? @image-url("icons/network.svg") : entry.kind == "WLX" ? @image-url("icons/eye.svg") : @image-url("icons/file.svg"); colorize: entry.enabled ? Colors.accent : Colors.muted; width: 20px; height: 20px; }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 4px;
                                    Text { text: entry.name; color: Colors.text; font-weight: 600; overflow: elide; }
                                    Text { text: entry.kind + " · " + entry.architecture + " · " + (entry.enabled ? @tr("Aktiv") : @tr("Deaktiviert")); color: entry.enabled ? Colors.accent : Colors.muted; font-size: 11px; }
                                }
                            }
                            TouchArea { enabled: !root.busy; clicked => { root.choose(index); plugin-keys.focus(); } }
                        }
                    }
                    if root.entries.length == 0 : Text { text: @tr("Keine passenden Plugins."); color: Colors.muted; horizontal-alignment: center; vertical-alignment: center; }
                    plugin-keys := FocusScope {
                        width: 0px; height: 0px;
                        key-pressed(event) => {
                            if (root.busy || root.entries.length == 0) { return reject; }
                            if (event.text == Key.DownArrow) { root.choose(root.selection + 1); return accept; }
                            if (event.text == Key.UpArrow) { root.choose(root.selection - 1); return accept; }
                            if (event.text == Key.Home) { root.choose(0); return accept; }
                            if (event.text == Key.End) { root.choose(root.entries.length - 1); return accept; }
                            if (event.text == Key.PageDown) { root.choose(root.selection + max(1, floor(plugin-list.visible-height / 64px))); return accept; }
                            if (event.text == Key.PageUp) { root.choose(root.selection - max(1, floor(plugin-list.visible-height / 64px))); return accept; }
                            return reject;
                        }
                    }
                }
            }
            ScrollView {
                width: 330px; viewport-width: self.visible-width;
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    FormSection {
                        title: root.selected ? root.item.name : @tr("Plugin auswählen");
                        description: root.selected ? root.item.kind + " · " + root.item.architecture : @tr("Registriere eine DLL oder installiere ein ZIP-Paket.");
                        if root.selected : Text { text: root.item.path; color: Colors.muted; wrap: char-wrap; font-size: 11px; }
                        if root.selected : FieldLabel { text: @tr("Dateimasken"); }
                        if root.selected : Text { text: root.item.masks == "" ? @tr("Alle bei manueller Auswahl") : root.item.masks; color: Colors.text; wrap: char-wrap; }
                        if root.item.detection != "" : Text { text: @tr("TC-Erkennung:") + " " + root.item.detection; color: Colors.muted; wrap: char-wrap; }
                        Button { text: root.item.enabled ? @tr("Deaktivieren") : @tr("Aktivieren"); enabled: root.selected && !root.busy; clicked => { root.operate("toggle", root.selection); } }
                    }
                    FormSection {
                        title: @tr("Funktionen");
                        HorizontalLayout {
                            spacing: 7px;
                            Button { text: @tr("Prüfen"); icon: @image-url("icons/check.svg"); enabled: root.selected && !root.busy; clicked => { root.operate("probe", root.selection); } }
                            Button { text: @tr("Ausführen"); primary: true; enabled: root.selected && root.item.enabled && !root.busy; clicked => { root.operate("run", root.selection); } }
                        }
                        if root.item.kind == "WCX" || root.item.kind == "WFX" : Button { text: @tr("Dateioperationen …"); enabled: root.item.enabled && !root.busy; clicked => { root.operate("files", root.selection); } }
                        if root.item.kind == "WDX" : Button { text: @tr("WDX-Spalte hinzufügen …"); enabled: root.item.enabled && !root.busy; clicked => { root.operate("column", root.selection); } }
                        Button { text: @tr("Registrierung bearbeiten …"); icon: @image-url("icons/edit.svg"); enabled: root.selected && !root.busy; clicked => { root.operate("edit", root.selection); } }
                    }
                }
            }
        }
        if root.notice != "" : Text { text: root.notice; color: Colors.archive; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: @tr("Entfernen …"); icon: @image-url("icons/trash.svg"); destructive: true; enabled: root.selected && !root.busy; clicked => { root.operate("remove", root.selection); } }
            Text { text: root.query == "" ? @tr("Die Listenreihenfolge bestimmt die Plugin-Priorität.") : @tr("Zum Umordnen den Filter leeren."); color: Colors.muted; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; font-size: 11px; }
            plugin-close := Button { text: @tr("Schließen"); clicked => { root.close(); } }
        }
    }
    init => { filter-input.focus(); }
}

component FtpBrowserCard inherits FocusScope {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { root.focus(); } else { close-browser.focus(); } }
    in property <string> url;
    in property <[FtpRowData]> rows;
    in property <bool> has-parent;
    in property <bool> detailed;
    in property <bool> busy;
    in-out property <int> selection;
    callback browse(string, int);
    callback close();
    init => { self.focus(); }

    function keep-visible() {
        let top = root.selection * 36px;
        if top + choices.viewport-y < 0px { choices.viewport-y = -top; }
        if top + 36px + choices.viewport-y > choices.height {
            choices.viewport-y = min(0px, choices.height - top - 36px);
        }
    }

    changed selection => { root.keep-visible(); }
    key-pressed(event) => {
        if (event.text == Key.Escape) { root.close(); return accept; }
        if (root.busy) { return reject; }
        if (event.text == Key.Backspace && root.has-parent) { root.browse("up", -1); return accept; }
        if (root.rows.length == 0) { return reject; }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            root.selection = clamp(root.selection + (event.text == Key.UpArrow ? -1 : 1), 0, root.rows.length - 1);
            return accept;
        }
        if (event.text == Key.PageUp) { root.selection = max(0, root.selection - max(1, floor(choices.height / 36px))); return accept; }
        if (event.text == Key.PageDown) { root.selection = min(root.rows.length - 1, root.selection + max(1, floor(choices.height / 36px))); return accept; }
        if (event.text == Key.Home) { root.selection = 0; return accept; }
        if (event.text == Key.End) { root.selection = root.rows.length - 1; return accept; }
        if (event.text == Key.Return) { root.browse("open", root.selection); return accept; }
        if (event.text == Key.F5) { root.browse("download", root.selection); return accept; }
        return reject;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        border-width: 1px;
        border-color: Colors.edge;
        background: Colors.panel;
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            DialogHeading { icon: @image-url("icons/network.svg"); title: @tr("FTP-Verzeichnis"); }
            HorizontalLayout {
                spacing: 6px;
                NavButton { icon: @image-url("icons/up.svg"); label: "Übergeordneter FTP-Ordner"; enabled: root.has-parent && !root.busy; clicked => { root.browse("up", -1); } }
                NavButton { icon: @image-url("icons/refresh.svg"); label: "FTP-Verzeichnis neu laden"; enabled: !root.busy; clicked => { root.browse("refresh", -1); } }
                DetailCell {
                    text: root.url;
                    horizontal-stretch: 1;
                    Tooltip { text: @markdown("\{root.url}"); }
                }
                NavButton { icon: @image-url("icons/edit.svg"); label: "FTP-Pfad eingeben"; enabled: !root.busy; clicked => { root.browse("path", -1); } }
            }
            if !root.detailed : Text {
                text: "Der Server liefert eine Namensliste. Weitere Ordner erreichst du über die Pfadeingabe.";
                color: Colors.muted;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-left: 31px; spacing: 8px;
                FieldLabel { text: @tr("Name"); horizontal-stretch: 1; }
                FieldLabel { text: @tr("Typ / Größe"); width: 95px; }
                FieldLabel { text: @tr("Datum"); width: 112px; }
            }
            choices := ListView {
                vertical-stretch: 1;
                accessible-label: "Dateien und Ordner auf dem FTP-Server";
                for row[index] in root.rows : Rectangle {
                    height: 36px;
                    background: index == root.selection ? Colors.selection : (Math.mod(index, 2) == 0 ? Colors.background : Colors.surface);
                    accessible-role: list-item;
                    accessible-label: row.name + " " + row.info;
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 8px;
                        Image {
                            source: row.directory ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                            width: 17px; height: 17px;
                            colorize: row.directory ? Colors.folder : Colors.muted;
                        }
                        Text { text: row.name; color: Colors.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        DetailCell { text: row.info; width: 95px; }
                        DetailCell { text: row.modified; width: 112px; }
                    }
                    TouchArea {
                        clicked => { root.selection = index; root.focus(); root.browse("click", index); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 7px;
                Button {
                    text: root.rows.length > 0 && root.rows[root.selection].directory ? @tr("Ordner öffnen") : @tr("Herunterladen"); primary: true;
                    enabled: root.rows.length > 0 && !root.busy;
                    clicked => { root.browse("open", root.selection); }
                }
                Button { text: "Mit lokalem Ordner abgleichen"; enabled: !root.busy; clicked => { root.browse("sync", -1); } }
                Rectangle { horizontal-stretch: 1; }
                close-browser := Button { text: @tr("Schließen"); clicked => { root.close(); } }
            }
        }
    }
}

component FtpEditCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { edit-copy.focus(); } else if (upload.enabled) { upload.focus(); } else { close-button.focus(); } }
    in property <string> name;
    in property <string> local-path;
    in property <string> remote-path;
    in property <bool> pending;
    callback perform(int);
    callback close();
    background: Colors.panel; border-radius: 16px; border-width: 1px; border-color: Colors.edge;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        DialogHeading { icon: @image-url("icons/edit.svg"); title: @tr("FTP-Datei bearbeiten"); subtitle: root.name; }
        ScrollView {
            vertical-stretch: 1; viewport-width: self.visible-width;
            VerticalLayout {
                spacing: 10px; alignment: start;
                FormSection { title: @tr("Serverdatei"); Text { text: root.remote-path; color: Colors.text; wrap: char-wrap; } }
                FormSection {
                    title: @tr("Lokale Arbeitskopie"); description: @tr("Im Editor speichern und danach die Änderungen hochladen.");
                    Text { text: root.local-path; color: Colors.muted; wrap: char-wrap; }
                    edit-copy := Button { text: @tr("Im Editor öffnen"); icon: @image-url("icons/edit.svg"); clicked => { root.perform(1); } }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: @tr("Kopie behalten und beenden"); enabled: !root.pending; clicked => { root.perform(2); } }
                        Button { text: @tr("Kopie löschen …"); icon: @image-url("icons/trash.svg"); destructive: true; enabled: !root.pending; clicked => { root.perform(3); } }
                    }
                }
                if root.pending : Text { text: @tr("Rückübertragung im Transfermanager vorgemerkt."); color: Colors.accent; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: 8px; Rectangle { horizontal-stretch: 1; }
            close-button := Button { text: @tr("Schließen"); clicked => { root.close(); } }
            upload := Button { text: @tr("Änderungen hochladen"); icon: @image-url("icons/archive.svg"); primary: true; enabled: !root.pending; clicked => { root.perform(0); } }
        }
    }
    init => { close-button.focus(); }
}

export struct RenameSearch {
    find: string,
    replacement: string,
    regex: bool,
    wildcards: bool,
    match-case: bool,
    first-only: bool,
    include-extension: bool,
    substitute: bool,
}

component RenameCard inherits Rectangle {
    property <bool> show-help;
    in property <int> focus-cycle;
    in property <int> revision;
    in property <string> value;
    in property <string> extension;
    in property <RenameSearch> search;
    in property <bool> separate;
    in property <string> selection;
    in property <string> notice;
    callback preview(string, string, RenameSearch);
    callback edited();
    callback close();
    background: Colors.panel; border-radius: 16px; border-color: Colors.edge; border-width: 1px;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        DialogHeading { icon: @image-url("icons/edit.svg"); title: @tr("Mehrfach umbenennen"); subtitle: root.selection; }
        ScrollView {
            vertical-stretch: 1; viewport-width: self.visible-width;
            rename-form := VerticalLayout {
                alignment: start;
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle > 0) { name-mask.focus(); } else { rename-preview.focus(); } }
                property <int> revision: root.revision;
                property <string> extension-mask: root.extension;
                property <bool> include-extension: root.search.include-extension;
                spacing: 10px;
                function preview() {
                    root.preview(name-mask.text, self.extension-mask, {
                        find: find.text, replacement: replacement.text,
                        regex: regex.checked, wildcards: wildcards.checked,
                        match-case: match-case.checked, first-only: first-only.checked,
                        include-extension: self.include-extension, substitute: substitute.checked,
                    });
                }
                changed revision => {
                    name-mask.text = root.value;
                    self.extension-mask = root.extension;
                    find.text = root.search.find;
                    replacement.text = root.search.replacement;
                    regex.checked = root.search.regex;
                    wildcards.checked = root.search.wildcards;
                    match-case.checked = root.search.match-case;
                    first-only.checked = root.search.first-only;
                    self.include-extension = root.search.include-extension;
                    substitute.checked = root.search.substitute;
                    name-mask.focus();
                }
                FormSection {
                    title: @tr("Namensmasken");
                    description: @tr("[N] Name · [E] Erweiterung · [C] Zähler · [YMD] Datum");
                    Button { text: @tr("Weitere Platzhalter"); checkable: true; checked <=> root.show-help; }
                    if root.show-help : Text {
                        text: @tr("[A] ganzer Name · [B] Elternordner · [C10+5:3] Zähler · [hms] Uhrzeit · [U]/[L]/[F]/[n] Schreibweise · [X] Zwischenablage · [=Plugin.Feld] WDX-Wert");
                        color: Colors.muted; wrap: word-wrap;
                    }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: @tr("Namensmaske"); }
                        name-mask := LineEdit {
                            text: root.value;
                            accessible-label: @tr("Namensmaske");
                            edited => { root.edited(); }
                            accepted => { rename-form.preview(); }
                            init => { self.focus(); }
                        }
                    }
                    if root.separate : VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: @tr("Erweiterungsmaske"); }
                        LineEdit {
                            text <=> rename-form.extension-mask;
                            accessible-label: @tr("Erweiterungsmaske");
                            edited => { root.edited(); }
                            accepted => { rename-form.preview(); }
                        }
                    }
                }
                }
                FormSection { title: @tr("Suchen und Ersetzen");
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: @tr("Suchen nach (optional)"); }
                        find := LineEdit {
                            text: root.search.find;
                            accessible-label: @tr("Suchen nach (optional)");
                            edited => { root.edited(); }
                            accepted => { rename-form.preview(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: @tr("Ersetzen durch"); }
                        replacement := LineEdit {
                            text: root.search.replacement;
                            accessible-label: @tr("Ersetzen durch");
                            edited => { root.edited(); }
                            accepted => { rename-form.preview(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    regex := CheckBox { text: @tr("Regulärer Ausdruck"); checked: root.search.regex; toggled => { root.edited(); } }
                    match-case := CheckBox { text: @tr("Schreibweise beachten"); checked: root.search.match-case; toggled => { root.edited(); } }
                    first-only := CheckBox { text: @tr("Nur erster Treffer"); checked: root.search.first-only; toggled => { root.edited(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    if root.separate : CheckBox {
                        text: @tr("Erweiterung einbeziehen");
                        checked <=> rename-form.include-extension;
                        toggled => { root.edited(); }
                    }
                    substitute := CheckBox { text: @tr("Ganzen Namen ersetzen"); checked: root.search.substitute; toggled => { root.edited(); } }
                    wildcards := CheckBox { text: @tr("Platzhalter * und ?"); enabled: !regex.checked; checked: root.search.wildcards; toggled => { root.edited(); } }
                }
                }
            }

        }
        if root.notice != "" : Text { text: root.notice; color: Colors.archive; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 7px;
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Abbrechen"); clicked => { root.close(); } }
                rename-preview := Button { text: @tr("Vorschau"); primary: true; clicked => { rename-form.preview(); } }
            }

    }
}

component SyncOptionsCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { mode.focus(); } else { compare-button.focus(); } }
    in property <SyncOptionsData> data;
    in property <int> revision;
    in property <[string]> roots;
    in property <[string]> presets;
    in property <bool> has-selection;
    in property <int> archive-side;
    in property <bool> archive-writable;
    in property <bool> archive-left-secret;
    in property <bool> archive-right-secret;
    in property <bool> ftp;
    in property <string> notice;
    callback configure(SyncOptionsData, string, int, string, string);
    callback close();
    border-radius: 16px;
    border-width: 1px;
    border-color: Colors.edge;
    background: Colors.panel;

    function draft() -> SyncOptionsData {
        return {
            mode: mode.current-index,
            recursive: recursive.checked,
            empty-dirs: recursive.checked && empty-dirs.checked,
            selected-only: root.has-selection && selected-only.checked, by-content: by-content.checked,
            ignore-date: ignore-date.checked, masks: masks.text, remember-roots: remember-roots.checked,
        };
    }

    function reset() {
        mode.current-index = root.data.mode;
        recursive.checked = root.data.recursive;
        empty-dirs.checked = root.data.empty-dirs;
        selected-only.checked = root.data.selected-only;
        by-content.checked = root.data.by-content;
        ignore-date.checked = root.data.ignore-date;
        masks.text = root.data.masks;
        remember-roots.checked = root.data.remember-roots;
    }

    init => { root.reset(); }
    changed data => { root.reset(); }
    changed revision => { root.reset(); }

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        DialogHeading { icon: @image-url("icons/sync.svg"); title: root.ftp ? @tr("FTP mit lokalem Ordner abgleichen") : (root.archive-side == 2 ? @tr("Archive vergleichen") : @tr("Verzeichnisse synchronisieren")); }
        for folder[index] in root.roots : DetailCell {
            text: (index == 0 ? (root.ftp ? "Lokal  " : "Links  ") : (root.ftp ? "FTP  " : "Rechts  ")) + folder;
            Tooltip { text: @markdown("\{folder}"); }
        }
        ScrollView {
            viewport-width: self.visible-width;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 9px;
                alignment: start;
                FormSection { title: @tr("Abgleichrichtung");
                mode := ComboBox {
                    model: root.ftp
                        ? ["Beide Seiten abgleichen", "Lokal → FTP", "Lokal auf FTP spiegeln", "FTP → lokal"]
                        : ["Beide Seiten abgleichen", "Von links nach rechts kopieren", "Links nach rechts spiegeln", "Von rechts nach links kopieren"];
                    enabled: root.archive-side < 0 || root.archive-writable;
                    accessible-label: "Richtung der Synchronisierung";
                }
                if mode.current-index == 2 : Text {
                    text: root.ftp ? "Beim Spiegeln werden zusätzliche FTP-Einträge zum Löschen vorgeschlagen."
                        : "Beim Spiegeln werden zusätzliche Einträge rechts zum Löschen vorgeschlagen.";
                    color: Colors.accent;
                    wrap: word-wrap;
                }
                if root.ftp : Text {
                    text: "Der Abgleich verwendet Größe und UTC-Zeit aus MLSD. Beim Inhaltsvergleich fragt Arco zuerst eine angebotene Server-Prüfsumme ab. Falls nötig, lädt Arco die Datei zum Vergleichen herunter.";
                    color: Colors.muted;
                    wrap: word-wrap;
                }
                if root.archive-side >= 0 : Text {
                    text: root.archive-side == 2
                        ? "Arco vergleicht die Dateiinhalte beider Archive. Die Ergebnisliste ist schreibgeschützt."
                        : (root.archive-writable
                            ? "Arco vergleicht die Dateiinhalte. In der Vorschau legst du fest, welche Änderungen gespeichert werden."
                            : "Arco vergleicht die Dateiinhalte. Du kannst freigegebene Dateien in den lokalen Ordner kopieren.");
                    color: Colors.muted;
                    wrap: word-wrap;
                }
                }
                FormSection { title: @tr("Vergleichsoptionen");
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        spacing: 4px;
                        recursive := CheckBox { text: "Unterordner"; }
                        empty-dirs := CheckBox { text: "Leere Ordner"; enabled: recursive.checked; }
                        selected-only := CheckBox { text: "Nur markierte Einträge"; enabled: root.has-selection; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        by-content := CheckBox { text: "Nach Inhalt vergleichen"; enabled: root.archive-side < 0; }
                        ignore-date := CheckBox { text: "Datum ignorieren"; enabled: root.archive-side < 0; }
                    }
                }
                FieldLabel { text: @tr("Dateifilter"); }
                masks := LineEdit {
                    placeholder-text: "Dateimasken, z. B. *.txt;*.md | geheim*";
                    accessible-label: "Dateimasken mit optionalen Ausschlüssen";
                }
                }
                if root.archive-left-secret : FieldLabel { text: @tr("Passwort für das linke Archiv"); }
                left-password := LineEdit {
                    visible: root.archive-left-secret;
                    placeholder-text: @tr("Passwort für das linke Archiv");
                    accessible-label: @tr("Passwort für das linke Archiv");
                    input-type: password;
                }
                if root.archive-right-secret : FieldLabel { text: @tr("Passwort für das rechte Archiv"); }
                right-password := LineEdit {
                    visible: root.archive-right-secret;
                    placeholder-text: @tr("Passwort für das rechte Archiv");
                    accessible-label: @tr("Passwort für das rechte Archiv");
                    input-type: password;
                }
                FormSection { title: @tr("Gespeicherte Profile"); visible: root.archive-side < 0 && !root.ftp;
                HorizontalLayout {
                    visible: root.archive-side < 0 && !root.ftp;
                    spacing: 6px;
                    presets := ComboBox {
                        model: root.presets;
                        current-index: 0;
                        accessible-label: "Synchronisierungsprofil";
                    }
                    Button {
                        text: "Profil laden";
                        enabled: presets.current-index >= 0;
                        clicked => { root.configure(root.draft(), presets.current-value, 0, "", ""); }
                    }
                    Button {
                        text: @tr("Entfernen");
                        enabled: presets.current-index > 0;
                        clicked => { root.configure(root.draft(), presets.current-value, 3, "", ""); }
                    }
                }
                remember-roots := CheckBox {
                    visible: root.archive-side < 0 && !root.ftp;
                    text: "Verzeichnispaar im Profil speichern";
                }
                HorizontalLayout {
                    visible: root.archive-side < 0 && !root.ftp;
                    spacing: 6px;
                    preset-name := LineEdit { placeholder-text: "Profilname"; accessible-label: "Name des Profils"; }
                    Button { text: "Profil speichern"; clicked => { root.configure(root.draft(), preset-name.text, 1, "", ""); } }
                }
                }
            }
        }
        Text { text: root.notice; color: Colors.accent; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 7px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Abbrechen"); clicked => { root.close(); } }
            compare-button := Button {
                text: @tr("Vergleichen"); primary: true; icon: @image-url("icons/compare.svg");
                clicked => { root.configure(root.draft(), "", 2, left-password.text, right-password.text); }
                init => { self.focus(); }
            }
        }
    }
}

component ConflictPreview inherits Rectangle {
    in property <string> title;
    in property <string> path;
    in property <string> info;
    in property <string> preview;
    background: Colors.background;
    border-radius: 6px;
    VerticalLayout {
        padding: 8px;
        spacing: 5px;
        Text { text: root.title; color: Colors.accent; font-weight: 700; }
        Text { text: root.path; color: Colors.text; wrap: char-wrap; }
        Text { text: root.info; color: Colors.muted; wrap: word-wrap; }
        TextEdit {
            text: root.preview;
            read-only: true;
            vertical-stretch: 1;
            accessible-label: root.title + " Dateivorschau";
        }
    }
}

component FileConflictCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { choice.focus(); } else if (root.manual-name) { target-name.focus(); } else if (apply-conflict.enabled) { apply-conflict.focus(); } else { cancel-conflict.focus(); } }
    in property <FileConflictData> data;
    in property <[string]> options;
    callback decide(int, bool, string);
    callback cancel();
    property <bool> manual-name: root.data.manual-index >= 0 && choice.current-index == root.data.manual-index;
    background: Colors.panel;
    border-color: Colors.accent;
    border-width: 1px;
    border-radius: 10px;
    VerticalLayout {
        padding: 14px;
        spacing: 9px;
        DialogHeading { icon: @image-url("icons/compare.svg"); title: @tr("Datei am Ziel vorhanden"); }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            ConflictPreview { title: "Quelle"; path: root.data.source; info: root.data.source-info; preview: root.data.source-preview; horizontal-stretch: 1; }
            ConflictPreview { title: "Ziel"; path: root.data.target; info: root.data.target-info; preview: root.data.target-preview; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            choice := ComboBox { model: root.options; current-index: 0; accessible-label: "Aktion für den Dateikonflikt"; horizontal-stretch: 1; }
            all := CheckBox { text: "Für folgende Konflikte"; enabled: !root.manual-name; }
            cancel-conflict := Button { text: "Auftrag abbrechen"; clicked => { root.cancel(); } }
            apply-conflict := Button { text: @tr("Anwenden"); primary: true; enabled: choice.current-index >= 0 && (!root.manual-name || target-name.text != ""); clicked => { root.decide(choice.current-index, !root.manual-name && all.checked, target-name.text); } }
        }
        target-name := LineEdit { visible: root.manual-name; placeholder-text: @tr("Neuer Dateiname im selben Ordner"); accessible-label: @tr("Neuer Zielname"); }
    }
}

component TextComparisonCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { ignore-case.focus(); } }
    in property <DiffData> data;
    in property <int> revision;
    in property <bool> busy;
    callback navigate(int);
    callback compare(bool, bool, bool);
    callback save(int, bool, string);
    callback close();
    property <int> requested-side: -1;
    property <bool> requested-edit;

    function reset() {
        left.text = root.data.left-text;
        right.text = root.data.right-text;
        ignore-case.checked = root.data.ignore-case;
        ignore-whitespace.checked = root.data.ignore-whitespace;
        ignore-line-endings.checked = root.data.ignore-line-endings;
        root.requested-side = -1;
    }
    init => { root.reset(); }
    changed revision => { root.reset(); }
    background: Colors.panel;
    border-color: Colors.accent;
    border-width: 1px;
    border-radius: 10px;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        DialogHeading { icon: @image-url("icons/compare.svg"); title: root.data.binary ? @tr("Binärvergleich") : @tr("Dateien nach Inhalt vergleichen"); }
        HorizontalLayout {
            visible: !root.data.binary;
            spacing: 5px;
            ignore-case := CheckBox { text: "Groß-/Kleinschreibung ignorieren"; }
            ignore-whitespace := CheckBox { text: "Leerraum ignorieren"; }
            ignore-line-endings := CheckBox { text: "Zeilenenden ignorieren"; }
            Button {
                text: "Neu vergleichen";
                enabled: !root.busy && root.requested-side < 0;
                clicked => { root.compare(ignore-case.checked, ignore-whitespace.checked, ignore-line-endings.checked); }
            }
        }
        Text { text: root.data.summary; color: Colors.accent; }
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                DetailCell { text: "Links · " + root.data.left-path; }
                Text { text: root.data.left-range; color: Colors.muted; }
                left := TextEdit { read-only: !root.data.editable-left || root.busy || root.requested-side >= 0; vertical-stretch: 1; }
                Button {
                    text: "Bearbeitung links speichern";
                    visible: !root.data.binary;
                    enabled: root.data.editable-left && left.text != root.data.left-text && !root.busy && root.requested-side < 0;
                    clicked => { root.requested-side = 0; root.requested-edit = true; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                DetailCell { text: "Rechts · " + root.data.right-path; }
                Text { text: root.data.right-range; color: Colors.muted; }
                right := TextEdit { read-only: !root.data.editable-right || root.busy || root.requested-side >= 0; vertical-stretch: 1; }
                Button {
                    text: "Bearbeitung rechts speichern";
                    visible: !root.data.binary;
                    enabled: root.data.editable-right && right.text != root.data.right-text && !root.busy && root.requested-side < 0;
                    clicked => { root.requested-side = 1; root.requested-edit = true; }
                }
            }
        }
        if root.requested-side < 0 : HorizontalLayout {
            spacing: 5px;
            Button { text: root.data.binary ? "Vorherige Abweichungen" : "Vorheriger Unterschied"; enabled: root.data.has-previous && !root.busy; clicked => { root.navigate(-1); } }
            Button { text: root.data.binary ? "Nächste Abweichungen" : "Nächster Unterschied"; enabled: root.data.has-next && !root.busy; clicked => { root.navigate(1); } }
            Rectangle { horizontal-stretch: 1; }
            if !root.data.binary : Button { text: "← Nach links übernehmen"; enabled: root.data.has-change && !root.busy; clicked => { root.requested-side = 0; root.requested-edit = false; } }
            if !root.data.binary : Button { text: "Nach rechts übernehmen →"; enabled: root.data.has-change && !root.busy; clicked => { root.requested-side = 1; root.requested-edit = false; } }
            compare-close := Button {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle < 0) { self.focus(); } }
                text: @tr("Schließen"); clicked => { root.close(); }
            }
        }
        if root.requested-side >= 0 : HorizontalLayout {
            spacing: 5px;
            Text { text: root.requested-side == 0 ? "Ausgewählten Abschnitt in die linke Datei schreiben?" : "Ausgewählten Abschnitt in die rechte Datei schreiben?"; color: Colors.accent; horizontal-stretch: 1; vertical-alignment: center; }
            Button { text: @tr("Zurück"); clicked => { root.requested-side = -1; } }
            Button {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle < 0) { self.focus(); } }
                text: "Schreiben";
                clicked => {
                    root.save(root.requested-side, root.requested-edit, root.requested-side == 0 ? left.text : right.text);
                    root.requested-side = -1;
                }
            }
        }
    }
}

component SyncReviewCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { result-filter.focus(); } else if (run-sync.enabled && !root.comparison-only) { run-sync.focus(); } else { close-sync.focus(); } }
    in property <[string]> roots;
    in property <[SyncRowData]> rows;
    in property <string> summary;
    in property <bool> has-actions;
    in property <bool> has-deletes;
    in property <bool> copy-only;
    in property <bool> comparison-only;
    callback filter(int);
    callback choose(int, int);
    callback run(bool);
    callback close();
    border-radius: 16px;
    border-width: 1px;
    border-color: Colors.edge;
    background: Colors.panel;

    VerticalLayout {
        padding: 20px;
        spacing: 8px;
        DialogHeading { icon: @image-url("icons/sync.svg"); title: root.copy-only ? @tr("FTP-Kopie prüfen") : (root.comparison-only ? @tr("Archivvergleich") : @tr("Synchronisierung prüfen")); }
        HorizontalLayout {
            spacing: 10px;
            for folder[index] in root.roots : FormSection {
                title: index == 0 ? @tr("Links") : @tr("Rechts");
                Text { text: folder; color: Colors.text; overflow: elide; Tooltip { text: @markdown("\{folder}"); } }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            result-filter := ComboBox {
                width: 190px;
                model: ["Unterschiede", "Alle Einträge", "Gleiche Einträge", "Konflikte"];
                current-index: 0;
                accessible-label: "Ergebnisse anzeigen";
                selected => { approve.checked = false; root.filter(self.current-index); }
            }
            DetailCell { text: root.summary; horizontal-stretch: 1; }
        }
        ListView {
            accessible-label: "Vergleich und Kopierrichtungen";
            vertical-stretch: 1;
            for row[i] in root.rows : Rectangle {
                height: 52px;
                background: Math.mod(i, 2) == 0 ? Colors.background : Colors.surface;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: row.path; color: Colors.text; overflow: elide; accessible-label: row.path; }
                        DetailCell { text: "L  " + row.left + "     R  " + row.right + "     " + row.comparison; }
                    }
                    if row.can-left : Button {
                        text: @tr("Nach links"); icon: @image-url("icons/back.svg"); checkable: true; checked: row.action == 1;
                        accessible-label: "Nach links kopieren · " + row.path;
                        clicked => { approve.checked = false; root.choose(row.index, 1); }
                    }
                    if row.can-right : Button {
                        text: @tr("Nach rechts"); icon: @image-url("icons/forward.svg"); checkable: true; checked: row.action == 2;
                        accessible-label: "Nach rechts kopieren · " + row.path;
                        clicked => { approve.checked = false; root.choose(row.index, 2); }
                    }
                    if row.can-delete : Button {
                        text: @tr("Löschen"); icon: @image-url("icons/trash.svg"); destructive: true; checkable: true; checked: row.action == 3;
                        accessible-label: "Rechts löschen · " + row.path;
                        clicked => { approve.checked = false; root.choose(row.index, 3); }
                    }
                }
            }
        }
        Text {
            visible: !root.comparison-only;
            text: "Ausgeführt werden die ausgewählten Aktionen der angezeigten Einträge.";
            color: Colors.muted;
            wrap: word-wrap;
        }
        FormSection {
            title: @tr("Löschungen bestätigen"); visible: root.has-deletes;
            approve := CheckBox { text: @tr("Angezeigte Löschungen rechts dauerhaft ausführen"); }
        }
        HorizontalLayout {
            spacing: 7px;
            Rectangle { horizontal-stretch: 1; }
            close-sync := Button { text: @tr("Schließen"); clicked => { root.close(); } init => { self.focus(); } }
            run-sync := Button {
                visible: !root.comparison-only;
                text: root.copy-only ? @tr("Kopieren") : @tr("Synchronisieren"); primary: true; icon: @image-url("icons/sync.svg");
                enabled: root.has-actions && (!root.has-deletes || approve.checked);
                clicked => { root.run(approve.checked); }
            }
        }
    }
}

component ColumnButton inherits Button {
    compact: true;
    in property <string> label;
    in property <bool> sorted;
    in property <bool> descending;
    text: root.sorted ? root.label + (root.descending ? " ↓" : " ↑") : root.label;
    accessible-label: root.sorted ? root.label + (root.descending ? ", absteigend" : ", aufsteigend") : root.label;
}

component FileGlyph inherits Image {
    in property <string> kind;
    source: kind == "parent" ? @image-url("icons/up.svg") :
        kind == "folder" ? @image-url("icons/folder.svg") :
        kind == "link" ? @image-url("icons/link.svg") :
        kind == "image" ? @image-url("icons/image.svg") :
        kind == "archive" ? @image-url("icons/archive.svg") :
        kind == "code" ? @image-url("icons/code.svg") :
        kind == "media" ? @image-url("icons/media.svg") : @image-url("icons/file.svg");
    colorize: kind == "folder" ? Colors.folder : kind == "media" || kind == "image" ? Colors.media :
        kind == "archive" ? Colors.archive : kind == "link" || kind == "code" ? Colors.accent : Colors.muted;
    image-fit: contain;
}

component FolderTree inherits Rectangle {
    in property <TreeData> tree-data;
    in property <string> title: "Ordnerbaum";
    callback tree-row(int, int);
    callback close();
    callback return-to-list();
    background: Colors.panel;
    border-radius: 5px;
    changed tree-data => {
        if (root.tree-data.shown && root.tree-data.focused) {
            let top = root.tree-data.cursor * 25px;
            if (top < -folder-tree.viewport-y) {
                folder-tree.viewport-y = -top;
            } else if (top + 25px > -folder-tree.viewport-y + folder-tree.visible-height) {
                folder-tree.viewport-y = min(0px, folder-tree.visible-height - top - 25px);
            }
        }
    }

    VerticalLayout {
        padding: 4px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.title; color: Colors.muted; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            NavButton { icon: @image-url("icons/close.svg"); label: "Ordnerbaum schließen"; clicked => { root.close(); } }
        }
        folder-tree := ListView {
            vertical-stretch: 1;
            accessible-label: root.title;
            for row[index] in root.tree-data.rows : Rectangle {
                height: 25px;
                background: index == root.tree-data.cursor && root.tree-data.focused ? Colors.cursor : Colors.background;
                accessible-role: list-item;
                accessible-label: row.path;
                HorizontalLayout {
                    padding-left: min(row.depth, 20) * 13px + 4px;
                    spacing: 5px;
                    Rectangle {
                        width: 22px;
                        if row.expandable : Button {
                            compact: true;
                            text: row.expanded ? "−" : "+";
                            width: parent.width;
                            height: parent.height;
                            accessible-label: row.expanded ? "Ast schließen" : "Ast öffnen";
                            clicked => { root.tree-row(index, 1); root.return-to-list(); }
                        }
                    }
                    folder-label := Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 5px;
                            FileGlyph { kind: "folder"; width: 16px; height: 16px; }
                            DetailCell { text: row.title; horizontal-stretch: 1; }
                        }
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.tree-row(index, 0); root.return-to-list(); }
                        }
                    }
                }
            }
        }
    }
}

component FilePanel inherits Rectangle {
    in property <TreeData> tree-data;
    property <bool> custom-view: root.data.custom-columns.length > 0;
    out property <int> first-visible-row: max(0, floor(-listing.viewport-y / root.row-height));
    out property <int> visible-row-count: max(1, ceil(listing.visible-height / root.row-height));
    property <bool> show-wdx: !root.custom-view && root.data.local && root.data.detailed && root.data.wdx-headings.length > 0;
    property <bool> show-date: !root.custom-view && root.data.detailed && (!root.show-wdx || self.width >= 580px);
    property <length> wdx-width: clamp((self.width - 290px) / max(1, root.data.wdx-headings.length), 58px, 130px);
    in property <PanelData> data;
    in property <int> cursor: -1;
    in property <string> summary;
    in property <bool> busy;
    in property <bool> active;
    in property <string> side;
    in property <[string]> drives;
    in property <SettingsData> settings;
    property <bool> editing-location;
    property <bool> show-attributes: !root.custom-view && root.data.detailed && self.width >= (root.show-wdx ? 700px : 385px);
    property <length> list-size: Typography.size(root.settings.list-font-size);
    property <string> list-family: Typography.family(root.settings.list-font);
    property <length> row-height: root.data.thumbnails ? 82px : root.list-size + 12px;
    property <length> extension-width: max(53px, root.list-size * 4);
    property <length> size-width: max(77px, root.list-size * 5.8);
    property <length> date-width: max(105px, root.list-size * 8.4);
    property <length> attribute-width: max(51px, root.list-size * 3.7);
    callback action(string);
    callback navigate(string);
    callback select-crumb(int);
    callback filter(string);
    callback click-row(int, bool, bool, bool);
    callback tree-row(int, int);
    callback context-row(int, bool);
    callback drag-row(int);
    callback select-tab(int);
    callback return-to-list();
    border-width: 1px;
    border-radius: 10px;
    border-color: root.active ? Colors.accent : Colors.edge;
    background: Colors.panel;

    public function focus-path() {
        root.editing-location = true;
        location.text = root.data.path;
        location.focus();
        location.clear-selection();
    }

    public function cancel-path() -> bool {
        if (!root.editing-location) { return false; }
        root.editing-location = false;
        root.return-to-list();
        return true;
    }

    public function focus-filter() { quick-filter.focus(); }

    public function cursor-point() -> Point {
        return {
            x: listing.absolute-position.x + min(90px, listing.width / 2),
            y: listing.absolute-position.y + clamp(root.cursor * root.row-height + listing.viewport-y + root.row-height / 2, 0px, listing.visible-height)
        };
    }

    function scroll-to-cursor() {
        if (root.cursor < 0) { return; }
        let top = root.cursor * root.row-height;
        if (top < -listing.viewport-y) {
            listing.viewport-y = -top;
        } else if (top + root.row-height > -listing.viewport-y + listing.visible-height) {
            listing.viewport-y = min(0px, listing.visible-height - top - root.row-height);
        }
    }

    changed data => {
        if (root.active) { root.scroll-to-cursor(); }
    }
    changed cursor => {
        if (root.active) { root.scroll-to-cursor(); }
    }
    changed active => {
        if (root.active) { root.scroll-to-cursor(); }
    }
    changed row-height => {
        if (root.active) { root.scroll-to-cursor(); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.side; color: root.active ? Colors.accent : Colors.muted; vertical-alignment: center; font-size: 11px; font-weight: 800; }
            if root.settings.drive-list : ComboBox {
                model: root.drives;
                current-value: root.data.drive;
                accessible-label: @tr("Laufwerk");
                width: 70px;
                selected(value) => { root.navigate(value); root.return-to-list(); }
            }
            DetailCell { text: root.data.volume; horizontal-stretch: 1; }
            if root.settings.history-buttons : NavButton { icon: @image-url("icons/back.svg"); label: @tr("Zurück"); clicked => { root.action("back"); } }
            if root.settings.history-buttons : NavButton { icon: @image-url("icons/forward.svg"); label: @tr("Vorwärts"); clicked => { root.action("forward"); } }
            NavButton { icon: @image-url("icons/drive.svg"); label: @tr("Zum Laufwerksstamm"); clicked => { root.action("root"); } }
            NavButton { icon: @image-url("icons/up.svg"); label: @tr("Übergeordneter Ordner"); clicked => { root.action("up"); } }
            if !root.settings.current-path : NavButton { icon: @image-url("icons/edit.svg"); label: @tr("Pfad eingeben"); clicked => { root.focus-path(); } }
            if !root.settings.current-path : NavButton { icon: @image-url("icons/star.svg"); label: @tr("Ordnerfavoriten"); clicked => { root.action("favorites"); } }
        }
        if root.settings.drive-buttons : Flickable {
            height: 30px;
            viewport-height: self.height;
            viewport-width: max(self.width, drive-buttons.preferred-width);
            drive-buttons := HorizontalLayout {
                width: parent.viewport-width;
                height: parent.viewport-height;
                spacing: 3px;
                alignment: start;
                for drive in root.drives : Button {
                    text: drive;
                    accessible-label: @tr("Laufwerk") + " " + drive;
                    checkable: true;
                    checked: root.data.drive == drive;
                    clicked => { root.navigate(drive); root.return-to-list(); }
                }
            }
        }
        path-row := HorizontalLayout {
            visible: root.settings.current-path || root.editing-location;
            height: self.visible ? 34px : 0px;
            spacing: 4px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 80px;
                height: 34px;
                clip: true;
                if !root.editing-location : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Colors.surface;
                    border-radius: 6px;
                    if root.settings.breadcrumbs : Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: max(self.width, path-segments.preferred-width);
                        viewport-height: self.height;
                        viewport-x: min(0px, self.width - self.viewport-width);
                        path-segments := HorizontalLayout {
                            width: parent.viewport-width;
                            height: parent.viewport-height;
                            alignment: start;
                            padding-left: 5px;
                            padding-right: 5px;
                            spacing: 3px;
                            for crumb[index] in root.data.crumbs : HorizontalLayout {
                                spacing: 2px;
                                if index > 0 : Image { source: @image-url("icons/chevron.svg"); width: 10px; height: 10px; colorize: Colors.muted; }
                                Button {
                                    text: crumb.label;
                                    accessible-label: crumb.path;
                                    clicked => { root.select-crumb(index); root.return-to-list(); }
                                }
                            }
                        }
                    }
                    if !root.settings.breadcrumbs : DetailCell {
                        text: root.data.path;
                        x: 7px;
                        width: parent.width - 14px;
                        height: parent.height;
                    }
                }
                location := LineEdit {
                    visible: root.editing-location;
                    width: 100%;
                    height: 100%;
                    accessible-label: root.side + " Pfad";
                    changed has-focus => {
                        if (!self.has-focus) { root.editing-location = false; }
                    }
                    accepted(value) => { root.editing-location = false; root.navigate(value); root.return-to-list(); }
                }
            }
            NavButton { icon: @image-url("icons/edit.svg"); label: @tr("Pfad eingeben"); clicked => { root.focus-path(); } }
            NavButton { icon: @image-url("icons/star.svg"); label: @tr("Ordnerfavoriten"); clicked => { root.action("favorites"); } }
        }
        HorizontalLayout {
            spacing: 4px;
            if root.settings.folder-tabs : Flickable {
                height: 34px;
                horizontal-stretch: 1;
                viewport-width: max(self.width, root.data.tabs.length * 112px);
                viewport-height: self.height;
                viewport-x: min(0px, max(self.width - self.viewport-width, -root.data.tab * 112px));
                HorizontalLayout {
                    width: parent.viewport-width;
                    alignment: start;
                    spacing: 4px;
                    for tab[i] in root.data.tabs : Rectangle {
                        width: 108px;
                        VerticalLayout {
                            Button {
                                text: tab.label;
                                icon: tab.locked ? @image-url("icons/lock.svg") : @image-url("");
                                checkable: true;
                                checked: root.data.tab == i;
                                accessible-label: tab.path;
                                clicked => { root.select-tab(i); root.return-to-list(); }
                            }
                            if tab.has-tint : Rectangle { height: 3px; border-radius: 1px; background: tab.tint; }
                        }
                    }
                }
            }
            if root.settings.folder-tabs : NavButton { icon: @image-url("icons/plus.svg"); label: @tr("Neuer Tab"); clicked => { root.action("new-tab"); } }
            if root.settings.folder-tabs : NavButton { icon: @image-url("icons/close.svg"); label: @tr("Tab schließen"); clicked => { root.action("close-tab"); } }
            if root.settings.folder-tabs : NavButton { icon: @image-url("icons/settings.svg"); label: @tr("Ordner-Tab verwalten"); clicked => { root.action("tab-menu"); } }
            if !root.settings.folder-tabs : Rectangle { horizontal-stretch: 1; }
            quick-filter := LineEdit {
                text: root.data.filter;
                placeholder-text: @tr("Schnellfilter");
                accessible-label: root.side + @tr(" Schnellfilter");
                width: 112px;
                edited(value) => { root.filter(value); }
                accepted => { root.return-to-list(); }
            }
        }
        if root.tree-data.shown : FolderTree {
            tree-data: root.tree-data;
            title: root.side + " · Ordnerbaum";
            height: clamp(root.height / 4, 75px, 210px);
            tree-row(index, operation) => { root.tree-row(index, operation); }
            close => { root.action("directory-tree"); }
            return-to-list => { root.return-to-list(); }
        }
        column-scroll := ScrollView {
            vertical-stretch: 1;
            min-width: 0px;
            min-height: 0px;
            viewport-width: max(root.width - 12px, root.data.custom-width * 1px + 150px);
            viewport-height: self.visible-height;
            Rectangle {
                width: parent.viewport-width;
                height: parent.viewport-height;
                VerticalLayout {
                spacing: 4px;
                if root.settings.column-headers : Rectangle {
                    height: 28px;
                    background: Colors.surface;
                    border-radius: 4px;
                    HorizontalLayout {
                        spacing: 2px;
                        padding-left: 4px;
                        ColumnButton { label: "Name"; sorted: root.data.sort-column == "name"; descending: root.data.descending; horizontal-stretch: 1; clicked => { root.action("sort-name"); } }
                        if root.data.detailed && !root.custom-view : ColumnButton { label: @tr("Erw."); sorted: root.data.sort-column == "extension"; descending: root.data.descending; width: root.extension-width; clicked => { root.action("sort-extension"); } }
                        if root.data.detailed && !root.custom-view : ColumnButton { label: @tr("Größe"); sorted: root.data.sort-column == "size"; descending: root.data.descending; width: root.size-width; clicked => { root.action("sort-size"); } }
                        if root.show-date : ColumnButton { label: @tr("Datum"); sorted: root.data.sort-column == "time"; descending: root.data.descending; width: root.date-width; clicked => { root.action("sort-time"); } }
                        if root.show-attributes : ColumnButton { label: "Attr."; sorted: root.data.sort-column == "attributes"; descending: root.data.descending; width: root.attribute-width; clicked => { root.action("sort-attributes"); } }
                        if root.data.comments : DetailCell { text: @tr("Kommentar"); width: parent.width / 2; }
                        for title[column] in root.data.wdx-headings : ColumnButton {
                            visible: root.show-wdx;
                            width: root.show-wdx ? root.wdx-width : 0px;
                            label: title;
                            sorted: root.data.wdx-sort-index == column;
                            descending: root.data.descending;
                            clicked => { root.action("sort-wdx:" + column); }
                        }
                        for column in root.data.custom-columns : ColumnButton {
                            label: column.title;
                            width: column.width * 1px;
                            enabled: column.action != "";
                            sorted: column.action != "" && (column.wdx-index >= 0 ? root.data.wdx-sort-index == column.wdx-index : root.data.sort-column == column.key);
                            descending: root.data.descending;
                            clicked => { root.action(column.action); }
                        }
                    }
                }
                listing := ListView {
                    vertical-stretch: 1;
                    accessible-label: root.side + @tr(" Dateiliste");
                    for row[i] in root.data.rows : row-box := Rectangle {
                        property <bool> odd: Math.mod(i, 2) == 1;
                        property <bool> tinted: !row.selected && !(root.active && root.cursor == i) && (odd ? root.data.has-secondary : root.data.has-primary);
                        property <color> ink: odd ? root.data.secondary-ink : root.data.primary-ink;
                        height: root.row-height;
                        background: row.selected ? Colors.selection : (root.active && root.cursor == i ? Colors.cursor : (tinted ? (odd ? root.data.secondary : root.data.primary) : (odd ? Colors.panel : Colors.background)));
                        border-width: root.active && root.cursor == i ? 1px : 0px;
                        border-color: Colors.accent;
                        accessible-role: list-item;
                        accessible-label: row.full-name + " " + row.info + " " + row.time + " " + row.attributes;
                        HorizontalLayout {
                            padding-left: 7px;
                            spacing: 2px;
                            if !root.data.thumbnails : FileGlyph { kind: row.icon; width: 16px; height: 16px; }
                            if root.data.thumbnails : Rectangle {
                                width: 108px;
                                height: 72px;
                                border-radius: 5px;
                                background: Colors.surface;
                                if row.has-thumbnail : Image {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    source: row.thumbnail;
                                    image-fit: contain;
                                }
                                if !row.has-thumbnail : FileGlyph {
                                    kind: row.icon;
                                    width: 28px;
                                    height: 28px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Text { text: root.data.detailed && (!root.custom-view || root.data.custom-extension) ? row.name : row.full-name; color: row.custom-color ? (Colors.light ? row.light-color : row.dark-color) : (row-box.tinted ? row-box.ink : Colors.text); font-family: root.list-family; font-size: root.list-size; font-weight: 400; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                            if root.data.detailed && !root.custom-view : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted; width: root.extension-width; text: row.extension; font-family: root.list-family; font-size: root.list-size; }
                            if root.data.detailed && !root.custom-view : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted; width: root.size-width; text: row.info; font-family: root.list-family; font-size: root.list-size; horizontal-alignment: right; }
                            if root.show-date : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted; width: root.date-width; text: row.time; font-family: root.list-family; font-size: root.list-size; horizontal-alignment: right; }
                            if root.show-attributes : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted; width: root.attribute-width; text: row.attributes; font-size: root.list-size; horizontal-alignment: center; font-family: "Consolas"; }
                            if root.data.comments : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted; width: parent.width / 2; text: row.comment; font-family: root.list-family; font-size: root.list-size; }
                            for title[column] in root.data.wdx-headings : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted;
                                visible: root.show-wdx;
                                width: root.show-wdx ? root.wdx-width : 0px;
                                text: column < row.wdx-values.length ? row.wdx-values[column] : "";
                                font-family: root.list-family;
                                font-size: root.list-size;
                            }
                            for column in root.data.custom-columns : DetailCell { color: row-box.tinted ? row-box.ink : Colors.muted;
                                width: column.width * 1px;
                                text: column.expression-index >= 0 ? (column.expression-index < row.expression-values.length ? row.expression-values[column.expression-index] : "")
                                    : column.key == "extension" ? row.extension
                                    : column.key == "size" ? row.info
                                    : column.key == "time" ? row.time
                                    : column.key == "attributes" ? row.attributes
                                    : column.key == "comment" ? row.comment
                                    : column.wdx-index >= 0 && column.wdx-index < row.wdx-values.length ? row.wdx-values[column.wdx-index] : "";
                                horizontal-alignment: column.right-aligned ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                font-family: root.list-family;
                                font-size: root.list-size;
                            }
                        }
                        TouchArea {
                            property <bool> drag-started;
                            property <bool> control-down;
                            property <bool> shift-down;
                            property <bool> right-down;
                            enabled: !root.busy;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if (!self.drag-started) {
                                    root.click-row(i, self.control-down, self.shift-down, false);
                                    root.return-to-list();
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    self.drag-started = false;
                                    self.control-down = event.modifiers.control;
                                    self.shift-down = event.modifiers.shift;
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    self.right-down = true;
                                }
                                if (event.kind == PointerEventKind.cancel) { self.right-down = false; }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right && self.right-down) {
                                    self.right-down = false;
                                    if (self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height) {
                                        root.context-row(i, event.modifiers.shift);
                                        root.return-to-list();
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed && !self.drag-started && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px)) {
                                    self.drag-started = true;
                                    root.drag-row(i);
                                }
                            }
                        }
                    }
                }
                }
            }
        }
        if root.settings.panel-status || root.busy : Text {
            text: root.busy ? "Lädt …" : root.summary;
            height: 20px;
            color: root.busy ? Colors.accent : Colors.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <int> validation-revision;
    changed validation-revision => { if (root.error-page >= 0) { root.page = root.error-page; } }
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle < 0) { settings-ok.focus(); } }
    in property <SettingsData> current;
    in property <int> initial-page;
    in property <[string]> languages;
    in property <string> error;
    in property <int> error-page: -1;
    in property <string> status;
    in property <bool> shortcut-dirty;
    property <[string]> page-titles: [@tr("Allgemein"), @tr("Layout"), @tr("Bedienung"), @tr("Tastatur"), @tr("Schrift"), @tr("Dateiübertragung"), @tr("Programme")];
    property <[string]> page-details: [@tr("Sprache und Erscheinungsbild der Anwendung."), @tr("Sichtbare Leisten und Aufbau der Dateifenster."), @tr("Auswahl, versteckte Dateien und Schnellsuche."), @tr("Befehle suchen und eigene Tastenkürzel zuweisen."), @tr("Schrift und Größe mit direkter Vorschau."), @tr("Geschwindigkeit, Protokoll und Dateieigenschaften."), @tr("Externe Werkzeuge für Bearbeitung und Suche.")];
    changed error => { if (root.error != "" && root.error-page >= 0) { root.page = root.error-page; } }
    changed initial-page => { root.page = root.initial-page; }
    property <bool> dirty: root.draft != root.current || root.shortcut-dirty;
    in property <[ShortcutRow]> shortcut-commands;
    in property <[ShortcutRow]> shortcut-assigned;
    in property <string> shortcut-query;
    in property <string> shortcut-command;
    in property <string> shortcut-title;
    in property <string> shortcut-candidate;
    in property <string> shortcut-notice;
    in property <bool> shortcut-recording;
    in property <bool> shortcut-conflict;
    callback shortcut-filter(string);
    callback select-shortcut-command(string);
    callback edit-shortcut(string, string);
    callback apply(SettingsData, bool);
    callback close();
    property <int> page: root.initial-page;
    property <bool> toolbar: root.current.toolbar;
    property <bool> panel-toolbar: root.current.panel-toolbar;
    property <bool> drive-buttons: root.current.drive-buttons;
    property <bool> drive-list: root.current.drive-list;
    property <bool> folder-tabs: root.current.folder-tabs;
    property <bool> current-path: root.current.current-path;
    property <bool> breadcrumbs: root.current.breadcrumbs;
    property <bool> history-buttons: root.current.history-buttons;
    property <bool> column-headers: root.current.column-headers;
    property <bool> panel-status: root.current.panel-status;
    property <bool> command-line: root.current.command-line;
    property <bool> function-keys: root.current.function-keys;
    property <bool> numpad-folders: root.current.numpad-folders;
    property <int> quick-find-start: root.current.quick-find-start;
    property <bool> stacked: root.current.stacked;
    property <bool> light: root.current.light;
    property <bool> system-theme: root.current.system-theme;
    property <bool> show-hidden: root.current.show-hidden;
    property <int> list-font: root.current.list-font;
    property <int> list-font-size: root.current.list-font-size;
    property <int> language: root.current.language;
    property <string> editor: root.current.editor;
    property <string> everything: root.current.everything;
    property <string> transfer-rate: root.current.transfer-rate;
    property <string> transfer-log: root.current.transfer-log;
    property <bool> transfer-comments: root.current.transfer-comments;
    property <bool> ntfs-streams: root.current.ntfs.streams;
    property <bool> ntfs-permissions: root.current.ntfs.permissions;
    property <bool> ntfs-owner: root.current.ntfs.owner;
    property <bool> ntfs-audit: root.current.ntfs.audit;
    property <bool> ntfs-hardlinks: root.current.ntfs.hardlinks;
    property <bool> ntfs-sparse: root.current.ntfs.sparse;
    property <bool> ntfs-creation-time: root.current.ntfs.creation-time;
    property <bool> ntfs-copy-links: root.current.ntfs.copy-links;
    in property <int> applied-revision;
    changed applied-revision => { root.reset-draft(); }
    changed current => { root.reset-draft(); }
    function reset-draft() {
        root.toolbar = root.current.toolbar;
        root.panel-toolbar = root.current.panel-toolbar;
        root.drive-buttons = root.current.drive-buttons;
        root.drive-list = root.current.drive-list;
        root.folder-tabs = root.current.folder-tabs;
        root.current-path = root.current.current-path;
        root.breadcrumbs = root.current.breadcrumbs;
        root.history-buttons = root.current.history-buttons;
        root.column-headers = root.current.column-headers;
        root.panel-status = root.current.panel-status;
        root.command-line = root.current.command-line;
        root.function-keys = root.current.function-keys;
        root.numpad-folders = root.current.numpad-folders;
        root.quick-find-start = root.current.quick-find-start;
        root.stacked = root.current.stacked;
        root.light = root.current.light;
        root.system-theme = root.current.system-theme;
        root.show-hidden = root.current.show-hidden;
        root.list-font = root.current.list-font;
        root.list-font-size = root.current.list-font-size;
        root.language = root.current.language;
        root.editor = root.current.editor;
        root.everything = root.current.everything;
        root.transfer-rate = root.current.transfer-rate;
        root.transfer-log = root.current.transfer-log;
        root.transfer-comments = root.current.transfer-comments;
        root.ntfs-streams = root.current.ntfs.streams;
        root.ntfs-permissions = root.current.ntfs.permissions;
        root.ntfs-owner = root.current.ntfs.owner;
        root.ntfs-audit = root.current.ntfs.audit;
        root.ntfs-hardlinks = root.current.ntfs.hardlinks;
        root.ntfs-sparse = root.current.ntfs.sparse;
        root.ntfs-creation-time = root.current.ntfs.creation-time;
        root.ntfs-copy-links = root.current.ntfs.copy-links;
    }
    property <SettingsData> draft: {
        toolbar: root.toolbar, panel-toolbar: root.panel-toolbar, drive-buttons: root.drive-buttons,
        drive-list: root.drive-list, folder-tabs: root.folder-tabs, current-path: root.current-path,
        breadcrumbs: root.breadcrumbs, history-buttons: root.history-buttons,
        column-headers: root.column-headers, panel-status: root.panel-status,
        command-line: root.command-line, function-keys: root.function-keys,
        numpad-folders: root.numpad-folders, stacked: root.stacked, light: root.light,
        quick-find-start: root.quick-find-start,
        system-theme: root.system-theme,
        show-hidden: root.show-hidden, list-font: root.list-font, list-font-size: root.list-font-size,
        language: root.language, editor: root.editor, everything: root.everything,
        transfer-rate: root.transfer-rate, transfer-log: root.transfer-log, transfer-comments: root.transfer-comments,
        ntfs: {
            streams: root.ntfs-streams, permissions: root.ntfs-permissions, owner: root.ntfs-owner,
            audit: root.ntfs-audit, hardlinks: root.ntfs-hardlinks, sparse: root.ntfs-sparse,
            creation-time: root.ntfs-creation-time, copy-links: root.ntfs-copy-links
        }
    };
    border-radius: 16px;
    border-width: 1px;
    border-color: Colors.edge;
    background: Colors.panel;

    FocusScope {
        width: 100%; height: 100%; focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (!root.shortcut-recording && event.modifiers.control && (event.text == Key.PageUp || event.text == Key.PageDown)) {
                root.page = Math.mod(root.page + (event.text == Key.PageUp ? 6 : 1), 7);
                if (root.page != 3) { root.edit-shortcut("stop", ""); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            DialogHeading { icon: @image-url("icons/settings.svg"); title: @tr("Einstellungen"); }
            Rectangle { height: 1px; background: Colors.edge; }
            HorizontalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                VerticalLayout {
                    width: 178px;
                    alignment: start;
                    spacing: 5px;
                    for label[index] in [@tr("Allgemein"), @tr("Layout"), @tr("Bedienung"), @tr("Tastatur"), @tr("Schrift"), @tr("Dateiübertragung"), @tr("Programme")] : ActionButton {
                        property <int> cycle: root.focus-cycle;
                        property <int> active-page: root.page;
                        changed active-page => { if (index == root.page) { self.focus(); } }
                        changed cycle => { if (self.cycle > 0 && index == root.page) { self.focus(); } }
                        text: label;
                        min-height: 32px;
                        icon: index == 0 ? @image-url("icons/settings.svg")
                            : index == 1 ? @image-url("icons/folder.svg")
                            : index == 2 ? @image-url("icons/check.svg")
                            : index == 3 ? @image-url("icons/terminal.svg")
                            : index == 4 ? @image-url("icons/edit.svg")
                            : index == 5 ? @image-url("icons/move.svg") : @image-url("icons/code.svg");
                        checkable: true;
                        checked: root.page == index;
                        clicked => { root.page = index; if (index != 3) { root.edit-shortcut("stop", ""); } }
                        init => { if (index == root.initial-page) { self.focus(); } }
                    }
                }
                Rectangle { width: 1px; background: Colors.edge; }
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 10px;
                    FieldLabel { text: root.page-titles[root.page]; font-size: 18px; }
                    Text { text: root.page-details[root.page]; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                    if root.page == 0 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 10px;
                            FormSection { title: @tr("Oberflächensprache");
                                ComboBox { model: root.languages; current-index <=> root.language; accessible-label: @tr("Oberflächensprache"); }
                            }
                            FormSection { title: @tr("Farbschema");
                                CheckBox { text: @tr("Windows-Farbschema verwenden"); checked <=> root.system-theme; }
                                CheckBox { text: @tr("Helles Farbschema"); checked <=> root.light; enabled: !root.system-theme; }

                            }
                        }
                    }
                    if root.page == 1 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            FormSection { title: @tr("Symbolleisten");
                                CheckBox { text: @tr("Obere Symbolleiste anzeigen"); checked <=> root.toolbar; }
                                CheckBox { text: @tr("Symbolleiste zwischen den Dateifenstern anzeigen"); checked <=> root.panel-toolbar; }
                            }
                            FormSection { title: @tr("Dateifenster und Navigation");
                                CheckBox { text: @tr("Laufwerksbuttons anzeigen"); checked <=> root.drive-buttons; }
                                CheckBox { text: @tr("Laufwerksliste anzeigen"); checked <=> root.drive-list; }
                                CheckBox { text: @tr("Ordner-Tabs anzeigen"); checked <=> root.folder-tabs; }
                                CheckBox { text: @tr("Aktuellen Pfad anzeigen"); checked <=> root.current-path; }
                                CheckBox { text: @tr("Anklickbare Pfadsegmente"); enabled: root.current-path; checked <=> root.breadcrumbs; }
                                CheckBox { text: @tr("Zurück- und Vorwärtsbuttons anzeigen"); checked <=> root.history-buttons; }
                                CheckBox { text: @tr("Spaltenüberschriften anzeigen"); checked <=> root.column-headers; }
                                CheckBox { text: @tr("Status der Dateilisten anzeigen"); checked <=> root.panel-status; }
                                CheckBox { text: @tr("Befehlszeile anzeigen"); checked <=> root.command-line; }
                                CheckBox { text: @tr("Funktionstastenleiste anzeigen"); checked <=> root.function-keys; }
                                CheckBox { text: @tr("Dateifenster übereinander"); checked <=> root.stacked; }
                            }
                        }
                    }
                    if root.page == 2 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 10px;
                            FormSection { title: @tr("Auswahl und Navigation");
                                CheckBox { text: @tr("Mit Num + und Num * auch Ordner markieren"); checked <=> root.numpad-folders; }
                                Text { text: @tr("Schnellsuche starten"); color: Colors.text; }
                                ComboBox { model: [@tr("Über das Tastenkürzel"), @tr("Beim Tippen"), @tr("Mit Alt"), @tr("Mit Strg+Alt")]; current-index <=> root.quick-find-start; accessible-label: @tr("Schnellsuche starten"); }
                                CheckBox { text: @tr("Versteckte Dateien anzeigen"); checked <=> root.show-hidden; }
                                DetailCell { text: @tr("Strg-Klick markiert einzelne Einträge. Umschalt-Klick markiert einen Bereich."); wrap: word-wrap; }

                            }
                        }
                    }
                    if root.page == 3 : VerticalLayout {
                        spacing: 7px;
                        LineEdit {
                            text: root.shortcut-query;
                            placeholder-text: @tr("Befehl filtern");
                            accessible-label: @tr("Befehl für Tastenkürzel filtern");
                            edited(value) => { root.shortcut-filter(value); }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;
                            ListView {
                                horizontal-stretch: 1;
                                min-width: 175px;
                                accessible-label: @tr("Belegbare Befehle");
                                for row in root.shortcut-commands : Button {
                                    height: 31px;
                                    text: row.label;
                                    checkable: true;
                                    checked: root.shortcut-command == row.key;
                                    clicked => { root.select-shortcut-command(row.key); }
                                }
                            }
                            VerticalLayout {
                                width: 246px;
                                spacing: 5px;
                                DetailCell { text: root.shortcut-title; font-size: 14px; font-weight: 700; }
                                if root.shortcut-assigned.length == 0 : DetailCell { text: @tr("Ohne Belegung"); }
                                if root.shortcut-assigned.length > 0 : ListView {
                                    height: 72px;
                                    accessible-label: @tr("Aktuelle Belegungen");
                                    for binding in root.shortcut-assigned : HorizontalLayout {
                                        spacing: 3px;
                                        height: 32px;
                                        DetailCell { text: binding.label; horizontal-stretch: 1; }
                                        Button { text: @tr("Entfernen"); accessible-label: binding.label + @tr(" entfernen"); clicked => { root.edit-shortcut("remove", binding.key); } }
                                    }
                                }
                                Button {
                                    text: root.shortcut-recording ? @tr("Aufnahme abbrechen") : @tr("Tastenkürzel aufzeichnen");
                                    enabled: root.shortcut-command != "";
                                    clicked => { root.edit-shortcut(root.shortcut-recording ? "stop" : "record", ""); }
                                }
                                DetailCell {
                                    text: root.shortcut-recording ? @tr("Tastenkombination drücken · Esc bricht ab") : root.shortcut-candidate;
                                    color: Colors.accent;
                                    wrap: word-wrap;
                                }
                                if root.shortcut-notice != "" : DetailCell { text: root.shortcut-notice; wrap: word-wrap; }
                                Button {
                                    text: root.shortcut-conflict ? @tr("Belegung ersetzen") : @tr("Zuweisen");
                                    enabled: !root.shortcut-recording && root.shortcut-candidate != "";
                                    clicked => { root.edit-shortcut("assign", ""); }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                        HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: @tr("Standardbelegung laden"); clicked => { root.edit-shortcut("reset", ""); } }
                        }
                    }
                    if root.page == 4 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 10px;
                            FormSection { title: @tr("Schrift in den Dateilisten");
                                ComboBox { model: ["Segoe UI", "Arial", "Verdana"]; current-index <=> root.list-font; accessible-label: @tr("Schriftfamilie"); }
                                ComboBox { model: ["12 px", "14 px", "16 px", "18 px"]; current-index <=> root.list-font-size; accessible-label: @tr("Schriftgröße"); }
                                Rectangle {
                                    min-height: 40px;
                                    background: Colors.surface;
                                    border-radius: 4px;
                                    Text {
                                        x: 10px;
                                        height: parent.height;
                                        text: "Ordnerübersicht_2026.txt · 128 KiB";
                                        color: Colors.text;
                                        font-family: Typography.family(root.list-font);
                                        font-size: Typography.size(root.list-font-size);
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                }

                            }
                        }
                    }
                    if root.page == 5 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            width: parent.visible-width;
                            spacing: 8px;
                            FormSection { title: @tr("Geschwindigkeit und Protokoll");
                                Text { text: @tr("Übertragungsrate (KiB/s)"); color: Colors.muted; }
                                LineEdit { text <=> root.transfer-rate; accessible-label: @tr("Übertragungsrate (KiB/s)"); }
                                DetailCell { text: @tr("0 bedeutet unbegrenzt."); }
                                Text { text: @tr("Protokolldatei"); color: Colors.muted; }
                                LineEdit { text <=> root.transfer-log; placeholder-text: @tr("Absoluter Pfad (optional)"); accessible-label: @tr("Protokolldatei"); }
                                CheckBox { text: @tr("Dateikommentare mitführen"); checked <=> root.transfer-comments; }
                            }
                            FormSection { title: @tr("NTFS-Kopieroptionen");
                                CheckBox { text: @tr("Benannte Datenströme übernehmen"); checked <=> root.ntfs-streams; }
                                CheckBox { text: @tr("Zugriffsrechte der Quelle übernehmen"); checked <=> root.ntfs-permissions; }
                                CheckBox { text: @tr("Besitzer übernehmen"); checked <=> root.ntfs-owner; }
                                CheckBox { text: @tr("Überwachungs-ACL übernehmen (erfordert Windows-Recht)"); checked <=> root.ntfs-audit; }
                                CheckBox { text: @tr("Hardlink-Gruppen im Ziel erhalten"); checked <=> root.ntfs-hardlinks; }
                                CheckBox { text: @tr("Nur belegte Bereiche von Sparse-Dateien kopieren"); checked <=> root.ntfs-sparse; }
                                CheckBox { text: @tr("Erstellungszeit übernehmen"); checked <=> root.ntfs-creation-time; }
                                CheckBox { text: @tr("Ausgewählte Verzeichnisjunctions als Links kopieren"); checked <=> root.ntfs-copy-links; }
                            }
                        }
                    }
                    if root.page == 6 : ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 10px;
                            FormSection { title: @tr("Externer Editor");
                                LineEdit { text <=> root.editor; placeholder-text: @tr("Absoluter Programmpfad"); accessible-label: @tr("Externer Editor"); }
                                DetailCell { text: @tr("Bei leerem Feld verwendet Arco den Windows-Editor."); wrap: word-wrap; }
                            }
                            FormSection { title: @tr("Everything-Suche");
                                LineEdit { text <=> root.everything; placeholder-text: @tr("Pfad zu es.exe"); accessible-label: @tr("Everything-Suche"); }
                                DetailCell { text: @tr("Bei leerem Feld verwendet Arco die interne Suche."); wrap: word-wrap; }

                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Colors.edge; }
            if root.error != "" : Text { text: root.error; color: Colors.archive; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.dirty ? @tr("Ungespeicherte Änderungen") : root.status != "" ? root.status : @tr("Strg+Bild auf/ab wechselt die Kategorie."); color: root.dirty ? Colors.archive : Colors.muted; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                Button { text: @tr("Abbrechen"); clicked => { root.close(); } }
                Button { text: @tr("Anwenden"); enabled: root.dirty; clicked => { root.apply(root.draft, false); } }
                settings-ok := Button { text: "OK"; primary: true; clicked => { root.apply(root.draft, true); } }
            }
        }
    }
}

component DrivePicker inherits FocusScope {
    in property <int> focus-cycle;
    changed focus-cycle => { root.focus(); }
    in property <string> title;
    in property <[string]> drives;
    in property <int> initial;
    property <int> selection: root.initial;
    callback choose(string);
    callback letter(string) -> bool;
    callback cancel();
    init => { self.focus(); }
    key-pressed(event) => {
        if (event.text == Key.Escape) { root.cancel(); return accept; }
        if (root.drives.length == 0) { return reject; }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            root.selection = clamp(root.selection + (event.text == Key.UpArrow ? -1 : 1), 0, root.drives.length - 1);
            choices.viewport-y = min(0px, max(choices.height - choices.viewport-height, -root.selection * 34px));
            return accept;
        }
        if (event.text == Key.Return) { root.choose(root.drives[root.selection]); return accept; }
        if (root.letter(event.text)) { return accept; }
        return reject;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        border-width: 1px;
        border-color: Colors.accent;
        background: Colors.panel;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: root.title; font-size: 17px; font-weight: 700; color: Colors.text; }
            choices := ListView {
                for drive[index] in root.drives : Button {
                    height: 34px;
                    text: drive;
                    checkable: true;
                    checked: index == root.selection;
                    clicked => { root.choose(drive); }
                }
            }
            DetailCell { text: "↑ ↓ wählen · Enter öffnen · Esc abbrechen"; }
        }
    }
}

export struct PreviewBounds { x: float, y: float, width: float, height: float }

component QuickView inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <string> body;
    in property <image> preview-image;
    in property <bool> embedded;
    property <PreviewBounds> bounds: {
        x: preview-body.absolute-position.x / 1px, y: preview-body.absolute-position.y / 1px,
        width: preview-body.width / 1px, height: preview-body.height / 1px,
    };
    callback bounds-changed(PreviewBounds);
    changed bounds => { root.bounds-changed(root.bounds); }
    init => { root.bounds-changed(root.bounds); }
    callback close();
    background: Colors.panel;
    border-width: 1px;
    border-color: Colors.edge;
    border-radius: 10px;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Image { source: @image-url("icons/eye.svg"); width: 18px; height: 18px; colorize: Colors.accent; }
            DetailCell { text: root.title == "" ? "Schnellansicht" : "Schnellansicht · " + root.title; horizontal-stretch: 1; accessible-label: self.text; }
            NavButton { icon: @image-url("icons/close.svg"); label: @tr("Schnellansicht schließen"); clicked => { root.close(); } }
        }
        if root.note != "" : DetailCell { text: root.note; }
        preview-body := Rectangle {
            vertical-stretch: 1;
            if !root.embedded && root.preview-image.width > 0 : Image {
                width: 100%; height: 100%;
                source: root.preview-image;
                image-fit: contain;
                accessible-label: root.title;
            }
            if !root.embedded && root.preview-image.width == 0 : TextEdit {
                width: 100%; height: 100%;
                text: root.body;
                font-family: "Consolas";
                read-only: true;
                accessible-label: @tr("Dateivorschau");
            }
        }
    }
}

export component ListerWindow inherits Window {
    title: root.lister-title;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 550px;
    min-height: 320px;
    background: Colors.background;

    in property <bool> light;
    in property <string> lister-title: "Arco Lister";
    in property <string> file-title;
    in property <bool> busy;
    in property <bool> has-page;
    in property <bool> has-image;
    in property <bool> has-rich;
    in property <bool> can-back;
    in property <bool> can-next;
    in property <bool> hex;
    in property <int> encoding;
    in property <[string]> encodings;
    in property <string> status;
    in property <string> preview-text;
    in property <image> preview-image;
    property <int> zoom-percent;
    out property <PreviewBounds> rich-bounds: {
        x: rich-host.absolute-position.x / 1px,
        y: rich-host.absolute-position.y / 1px,
        width: rich-host.width / 1px,
        height: rich-host.height / 1px
    };

    callback navigate(string);
    callback control(int, string, int);
    callback close-lister();
    callback view-raw();
    callback toggle-fullscreen();
    callback rich-resized();
    changed rich-bounds => { root.rich-resized(); }
    changed light => { Palette.color-scheme = root.light ? ColorScheme.light : ColorScheme.dark; }

    keyboard := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;
        init => { self.focus(); Palette.color-scheme = root.light ? ColorScheme.light : ColorScheme.dark; }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-lister(); return accept; }
            if event.modifiers.alt && event.text == Key.Return {
                root.toggle-fullscreen();
                return accept;
            }
            if root.has-image && !event.modifiers.alt {
                if event.modifiers.control && event.text == "0" {
                    root.zoom-percent = 100;
                    return accept;
                }
                if !event.modifiers.control {
                    if event.text == "f" || event.text == "F" {
                        root.zoom-percent = 0;
                        return accept;
                    }
                    if event.text == "+" || event.text == "-" {
                        root.step-zoom(event.text == "+" ? 25 : -25);
                        return accept;
                    }
                }
            }
            return reject;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 9px;
            DialogHeading {
                icon: @image-url("icons/eye.svg");
                title: @tr("Arco Lister");
                subtitle: root.file-title;
                wrap-subtitle: false;
            }
            if root.busy : ProgressRail { height: 4px; indeterminate: true; }
            Rectangle {
                vertical-stretch: 1;
                if root.has-page : ReaderPane {
                    width: 100%; height: 100%;
                    busy: root.busy;
                    hex: root.hex;
                    can-back: root.can-back;
                    can-next: root.can-next;
                    encoding: root.encoding;
                    encodings: root.encodings;
                    body: root.preview-text;
                    navigate(action) => { root.navigate(action); }
                    control(operation, value, option) => { root.control(operation, value, option); }
                }
                if root.has-image : ImagePane {
                    width: 100%; height: 100%;
                    picture: root.preview-image;
                    zoom: root.zoom-percent;
                }
                rich-host := Rectangle {
                    width: 100%; height: 100%;
                    visible: !root.has-page && !root.has-image;
                    background: Colors.panel;
                    border-radius: 8px;
                }
            }
            Rectangle { height: 1px; background: Colors.edge; }
            DetailCell { text: root.status; accessible-label: self.text; }
            HorizontalLayout {
                spacing: 6px;
                if root.has-rich : ActionButton {
                    icon: @image-url("icons/code.svg");
                    text: @tr("Quelldaten anzeigen");
                    enabled: !root.busy;
                    clicked => { root.view-raw(); }
                }
                if root.has-image : Button { text: @tr("Einpassen"); checkable: true; checked: root.zoom-percent == 0; clicked => { root.zoom-percent = 0; } }
                if root.has-image : Button { text: "−"; accessible-label: @tr("Bild verkleinern"); enabled: root.zoom-percent != 25; clicked => { root.step-zoom(-25); } }
                if root.has-image : Button { text: root.zoom-percent > 0 ? "\{root.zoom-percent} %" : "100 %"; accessible-label: @tr("Originalgröße"); clicked => { root.zoom-percent = 100; } }
                if root.has-image : Button { text: "+"; accessible-label: @tr("Bild vergrößern"); enabled: root.zoom-percent != 400; clicked => { root.step-zoom(25); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Vollbild"); clicked => { root.toggle-fullscreen(); } }
                Button { text: @tr("Schließen"); clicked => { root.close-lister(); } }
            }
        }
    }

    function step-zoom(delta: int) {
        root.zoom-percent = clamp((root.zoom-percent == 0 ? 100 : root.zoom-percent) + delta, 25, 400);
    }
}

export component MainWindow inherits Window {
    title: "Arco Commander";
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    icon: @image-url("icons/mark.svg");
    min-width: 910px;
    min-height: 460px;
    preferred-width: 1200px;
    preferred-height: 760px;
    background: Colors.background;
    property <ColorScheme> scheme: Colors.light ? ColorScheme.light : ColorScheme.dark;
    init => { Palette.color-scheme = root.scheme; }
    changed scheme => { Palette.color-scheme = root.scheme; }
    in property <PanelData> left;
    in property <PanelData> right;
    in property <FileConflictData> file-conflict;
    in property <DiffData> diff-data;
    in property <int> diff-revision;
    in property <int> separate-tree-mode;
    in property <TreeData> left-tree;
    in property <TreeData> right-tree;
    in property <[ButtonbarRow]> top-buttons;
    in property <[ButtonbarRow]> middle-buttons;
    in property <int> left-cursor: -1;
    in property <int> right-cursor: -1;
    in property <string> left-summary;
    in property <string> right-summary;
    in property <bool> left-busy;
    in property <bool> right-busy;
    out property <int> left-wdx-first: left-view.first-visible-row;
    out property <int> left-wdx-count: left-view.visible-row-count;
    out property <int> right-wdx-first: right-view.first-visible-row;
    out property <int> right-wdx-count: right-view.visible-row-count;
    in property <int> active-panel;
    in property <bool> stacked;
    in property <SettingsData> settings;
    in property <bool> settings-open;
    in property <SettingsData> settings-current;
    in property <int> settings-page;
    in property <[string]> settings-languages;
    in property <string> settings-error;
    in property <int> settings-error-page: -1;
    in property <int> settings-validation-revision;
    in property <int> settings-applied-revision;
    in property <string> settings-status;
    in property <bool> shortcut-dirty;
    in property <ShortcutLabels> shortcut-labels;
    in property <[ShortcutRow]> shortcut-commands;
    in property <[ShortcutRow]> shortcut-assigned;
    in property <string> shortcut-query;
    in property <string> shortcut-command;
    in property <string> shortcut-title;
    in property <string> shortcut-candidate;
    in property <string> shortcut-notice;
    in property <bool> shortcut-recording;
    in property <bool> shortcut-conflict;
    in property <int> drive-side: -1;
    in property <int> drive-selection;
    property <bool> dialog-open: root.dialog-kind != "" || root.settings-open || root.drive-side >= 0;
    out property <bool> job-activity-open: root.job-active && root.job-expanded && !root.dialog-open;
    property <bool> modal-open: root.dialog-open || root.job-activity-open;
    property <int> dialog-focus-cycle;
    in-out property <float> split-ratio: 0.5;
    in property <bool> quick-open;
    in property <string> quick-title;
    in property <string> quick-note;
    in property <string> quick-text;
    in property <bool> quick-embedded;
    in-out property <PreviewBounds> quick-bounds;
    in property <image> quick-image;
    in property <[string]> drives;
    in property <[MenuCategory]> command-menu;
    in property <[CommandRow]> palette-rows;
    callback menu-action(string);
    callback palette-query(string);
    callback palette-pick(string);
    in property <string> status: "Bereit";
    in property <bool> job-active;
    in property <bool> job-cancelling;
    in property <OperationKind> job-kind;
    in property <string> job-origin;
    in property <string> job-target;
    in-out property <bool> job-expanded;
    in property <string> job-title;
    in property <float> job-progress: -1;
    in property <string> job-status;
    in property <JobMetrics> job-metrics;
    in property <bool> job-pausable;
    in property <bool> job-paused;
    callback job-pause();
    callback browse-operation-target() -> string;
    in property <string> dialog-kind;
    in property <int> dialog-revision;
    in property <string> dialog-title;
    in property <string> dialog-description;
    in property <string> dialog-value;
    in property <int> dialog-content-lines;
    in property <string> dialog-second;
    in property <string> dialog-placeholder;
    in property <string> dialog-second-placeholder;
    in property <bool> dialog-secret;
    in property <bool> dialog-second-secret;
    in property <[string]> dialog-options;
    in property <string> dialog-options-label;
    in property <string> dialog-confirm-label;
    in property <[string]> dialog-transfer-filters;
    in property <string> dialog-operation-selection;
    in-out property <string> dialog-operation-target;
    in property <string> dialog-operation-note;
    in property <bool> dialog-operation-multiple;
    in property <bool> dialog-operation-move;
    in property <TransferManagerData> transfer-manager-data;
    in-out property <int> dialog-transfer-filter;
    in property <SyncOptionsData> sync-draft;
    in property <int> sync-draft-revision;
    in property <[string]> sync-roots;
    in property <[string]> sync-presets;
    in property <[string]> ftp-profile-names;
    in property <int> ftp-profile-index;
    in property <FtpProfileData> ftp-profile-data;
    in property <int> ftp-profile-revision;
    in property <string> ftp-profile-notice;
    in property <[PluginRowData]> plugin-entries;
    in-out property <int> plugin-selection: -1;
    in property <bool> sync-has-selection;
    in property <SearchDraft> search-draft;
    in property <[string]> search-profiles;
    in property <string> search-notice;
    in property <string> search-base;
    in property <bool> search-has-selection;
    in property <bool> search-archive;
    in property <[string]> search-wdx-profiles;
    in property <int> sync-archive-side: -1;
    in property <bool> sync-archive-writable;
    in property <bool> sync-archive-left-secret;
    in property <bool> sync-archive-right-secret;
    in property <bool> sync-ftp;
    in property <[FtpRowData]> ftp-rows;
    in-out property <int> ftp-cursor;
    in property <string> ftp-url;
    in property <bool> ftp-has-parent;
    in property <bool> ftp-detailed;
    in property <string> sync-notice;
    in property <[SyncRowData]> sync-rows;
    in property <string> sync-summary;
    in property <bool> sync-has-actions;
    in property <bool> sync-has-deletes;
    in property <bool> sync-copy-only;
    in property <bool> sync-comparison-only;
    in property <image> viewer-image;
    in property <bool> viewer-back;
    in property <bool> viewer-next;
    in property <string> viewer-mode;
    in property <int> viewer-encoding;
    in property <string> viewer-notice;
    callback action(string);
    callback command-line(string) -> bool;
    callback panel-action(int, string);
    callback navigate(int, string);
    callback select-crumb(int, int);
    callback filter(int, string);
    callback click-row(int, int, bool, bool, bool);
    callback tree-row(int, int, int);
    callback custom-button(int, int);
    callback context-row(int, int, bool);
    callback keyboard-context(float, float);
    callback shortcut-filter(string);
    callback select-shortcut-command(string);
    callback edit-shortcut(string, string);
    callback apply-settings(SettingsData, bool);
    callback show-drives(int);
    callback choose-drive(string);
    callback drive-letter(string) -> bool;
    callback drag-row(int, int);
    callback select-tab(int, int);
    callback submit(string, string, int);
    in property <string> rename-extension;
    in property <bool> rename-separate;
    in property <RenameSearch> rename-search;
    callback submit-multi-rename(string, string, RenameSearch);
    in property <string> rename-selection;
    in property <[ReviewRow]> review-rows;
    in property <OperationKind> review-kind;
    in property <string> review-primary-label;
    in property <string> review-secondary-label;
    in property <string> review-confirm-label;
    in property <bool> review-can-confirm;
    in property <bool> review-can-edit;
    callback copy-review-text(string);
    callback rename-edited();
    callback viewer-control(int, string, int);
    callback diff-navigate(int);
    callback diff-options(bool, bool, bool);
    callback diff-save(int, bool, string);
    callback directory-loaded();
    callback sync-configure(SyncOptionsData, string, int, string, string);
    callback search-configure(SearchDraft, string, int);
    callback sync-choose(int, int);
    callback sync-filter(int);
    callback sync-run(bool);
    callback ftp-browse(string, int);
    in property <bool> ftp-edit-pending;
    callback ftp-profile-select(int);
    callback ftp-profile-operate(string, FtpProfileData, string);
    callback plugin-operate(string, int);
    callback plugin-filter(string);
    in property <string> plugin-query;
    in property <string> plugin-notice;
    in property <int> plugin-total;

    public function focus-panels() { if (!root.modal-open) { keyboard.focus(); } }
    public function file-list-focused() -> bool { return !root.modal-open && keyboard.has-focus; }
    public function focus-active-path() { if (root.active-panel == 0) { left-view.focus-path(); } else { right-view.focus-path(); } }
    public function focus-active-filter() { if (root.active-panel == 0) { left-view.focus-filter(); } else { right-view.focus-filter(); } }
    public function focus-command-line() { if (root.settings.command-line) { command.focus(); } }
    function button-label(label: string, key: string) -> string { return key == "" ? label : key + "  " + label; }
    public function open-keyboard-context() {
        let point = root.active-panel == 0 ? left-view.cursor-point() : right-view.cursor-point();
        root.keyboard-context(point.x / 1px, point.y / 1px);
    }
    public function panel-at(x: float, y: float) -> int {
        let px = x * 1px;
        let py = y * 1px;
        if (left-view.visible && px >= left-view.absolute-position.x && py >= left-view.absolute-position.y
            && px < left-view.absolute-position.x + left-view.width && py < left-view.absolute-position.y + left-view.height) {
            return 0;
        }
        if (right-view.visible && px >= right-view.absolute-position.x && py >= right-view.absolute-position.y
            && px < right-view.absolute-position.x + right-view.width && py < right-view.absolute-position.y + right-view.height) {
            return 1;
        }
        return root.active-panel;
    }

    MenuBar {
        for category in root.command-menu : Menu {
            title: category.title;
            enabled: !root.modal-open;
            for row in category.primary : MenuItem {
                title: row.menu-label;
                icon: row.icon;
                activated => { root.menu-action(row.key); }
            }
            if category.sections.length > 0 : MenuSeparator {}
            for section in category.sections : Menu {
                title: section.title;
                icon: section.icon;
                for row in section.rows : MenuItem {
                    title: row.menu-label;
                    icon: row.icon;
                    activated => { root.menu-action(row.key); }
                }
            }
        }
    }

    keyboard := FocusScope {
        width: 100%; height: 100%;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.drive-side >= 0) { return reject; }
            if (root.settings-open) {
                if (event.text == Key.Escape) { root.action("close-settings"); return accept; }
                return reject;
            }
            if (root.dialog-kind != "") {
                if (event.text == Key.Escape) { root.action("close-dialog"); return accept; }
                return reject;
            }
            if (root.job-activity-open && event.text == Key.Escape) {
                root.job-expanded = false; keyboard.focus(); return accept;
            }
            if (event.text == Key.Escape && (left-view.cancel-path() || right-view.cancel-path())) { return accept; }
            if (event.text == Key.Escape && command.has-focus) { keyboard.focus(); return accept; }
            if (event.text == Key.Escape && root.job-active) { root.action("cancel-job"); return accept; }
            return reject;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            if root.settings.toolbar : Rectangle {
                height: 40px;
                background: Colors.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Colors.edge;
                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    spacing: 5px;
                    Image {
                        source: @image-url("icons/mark.svg");
                        width: 27px;
                        height: 27px;
                    }
                    Text { text: "Arco Commander"; color: Colors.text; font-weight: 800; font-size: 14px; vertical-alignment: center; }
                    Rectangle { width: 1px; background: Colors.edge; }
                    if root.top-buttons.length == 0 : HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 5px;
                    NavButton { icon: @image-url("icons/refresh.svg"); label: @tr("Aktualisieren"); clicked => { root.action("refresh"); } }
                    NavButton { icon: @image-url("icons/folder.svg"); label: @tr("Kurz- und Detailansicht wechseln"); clicked => { root.action("details"); } }
                    NavButton { icon: @image-url("icons/eye.svg"); label: @tr("Schnellansicht"); checkable: true; checked: root.quick-open; clicked => { root.action("quick-view"); } }
                    NavButton { icon: @image-url("icons/move.svg"); label: @tr("Fenster tauschen"); clicked => { root.action("swap"); } }
                    Rectangle { width: 1px; background: Colors.edge; }
                    NavButton { icon: @image-url("icons/archive.svg"); label: @tr("Dateien packen"); clicked => { root.action("zip-pack"); } }
                    NavButton { icon: @image-url("icons/archive-extract.svg"); label: @tr("Archiv entpacken"); clicked => { root.action("zip-extract"); } }
                    NavButton { icon: @image-url("icons/network.svg"); label: @tr("FTP-Verbindungen"); clicked => { root.action("ftp-profiles"); } }
                    Rectangle { width: 1px; background: Colors.edge; }
                    NavButton { icon: @image-url("icons/search.svg"); label: @tr("Dateien suchen"); clicked => { root.action("search"); } }
                    NavButton { icon: @image-url("icons/compare.svg"); label: @tr("Dateiinhalt vergleichen"); clicked => { root.action("compare"); } }
                    NavButton { icon: @image-url("icons/sync.svg"); label: @tr("Verzeichnisse synchronisieren"); clicked => { root.action("sync"); } }
                    }
                    if root.top-buttons.length > 0 : Flickable {
                        horizontal-stretch: 1;
                        viewport-width: max(self.width, top-bar.preferred-width);
                        viewport-height: self.height;
                        top-bar := HorizontalLayout {
                            width: parent.viewport-width;
                            height: parent.viewport-height;
                            alignment: start;
                            spacing: 5px;
                            for item[index] in root.top-buttons : CustomBarButton {
                                label: item.label;
                                icon-name: item.icon;
                                custom-icon: item.custom-icon;
                                clicked => { root.custom-button(0, index); }
                            }
                        }
                    }
                    if root.top-buttons.length == 0 : Rectangle { horizontal-stretch: 1; }
                    NavButton { icon: Colors.light ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg"); label: @tr("Farbschema wechseln"); clicked => { root.action("theme"); } }
                    NavButton { icon: @image-url("icons/settings.svg"); label: @tr("Einstellungen"); clicked => { root.action("settings"); } }
                    ActionButton {
                        icon: @image-url("icons/search.svg");
                        text: @tr("Befehlspalette") + (root.shortcut-labels.palette == "" ? "" : "  " + root.shortcut-labels.palette);
                        clicked => { root.action("palette"); }
                    }
                }
            }
            panels := Rectangle {
                vertical-stretch: 1;
                property <length> gap: root.settings.panel-toolbar ? 42px : 8px;
                property <length> sidebar: root.separate-tree-mode == 1 ? clamp(self.width * 0.22, 140px, 240px) : 0px;
                property <length> files-width: self.width - self.sidebar;
                if root.separate-tree-mode == 1 : FolderTree {
                    tree-data: root.active-panel == 0 ? root.left-tree : root.right-tree;
                    title: "Ordnerbaum · " + (root.active-panel == 0 ? @tr("Links") : @tr("Rechts"));
                    x: 0px; y: 0px;
                    width: panels.sidebar - 4px; height: panels.height;
                    tree-row(index, operation) => { root.tree-row(root.active-panel, index, operation); }
                    close => { root.action("separate-tree-off"); }
                    return-to-list => { root.focus-panels(); }
                }
                left-view := FilePanel {
                    tree-data: root.separate-tree-mode == 1 ? {} : root.left-tree;
                    visible: !root.quick-open || root.active-panel == 0;
                    data: root.left;
                    cursor: root.left-cursor;
                    summary: root.left-summary;
                    busy: root.left-busy;
                    active: root.active-panel == 0;
                    side: @tr("LINKS");
                    drives: root.drives;
                    settings: root.settings;
                    x: panels.sidebar; y: 0px;
                    width: root.stacked ? panels.files-width : (panels.files-width - panels.gap) * root.split-ratio;
                    height: root.stacked ? (parent.height - panels.gap) * root.split-ratio : parent.height;
                    action(command) => { root.panel-action(0, command); }
                    navigate(path) => { root.navigate(0, path); }
                    select-crumb(index) => { root.select-crumb(0, index); }
                    filter(value) => { root.filter(0, value); }
                    click-row(index, toggle, range, open) => { root.click-row(0, index, toggle, range, open); }
                    tree-row(index, operation) => { root.tree-row(0, index, operation); }
                    context-row(index, extended) => { root.context-row(0, index, extended); }
                    drag-row(index) => { root.drag-row(0, index); }
                    select-tab(index) => { root.select-tab(0, index); }
                    return-to-list => { root.focus-panels(); }
                }
                right-view := FilePanel {
                    tree-data: root.separate-tree-mode == 1 ? {} : root.right-tree;
                    visible: !root.quick-open || root.active-panel == 1;
                    data: root.right;
                    cursor: root.right-cursor;
                    summary: root.right-summary;
                    busy: root.right-busy;
                    active: root.active-panel == 1;
                    side: @tr("RECHTS");
                    drives: root.drives;
                    settings: root.settings;
                    x: root.stacked ? panels.sidebar : left-view.x + left-view.width + panels.gap;
                    y: root.stacked ? left-view.height + panels.gap : 0px;
                    width: parent.width - self.x;
                    height: root.stacked ? parent.height - self.y : parent.height;
                    action(command) => { root.panel-action(1, command); }
                    navigate(path) => { root.navigate(1, path); }
                    select-crumb(index) => { root.select-crumb(1, index); }
                    filter(value) => { root.filter(1, value); }
                    click-row(index, toggle, range, open) => { root.click-row(1, index, toggle, range, open); }
                    tree-row(index, operation) => { root.tree-row(1, index, operation); }
                    context-row(index, extended) => { root.context-row(1, index, extended); }
                    drag-row(index) => { root.drag-row(1, index); }
                    select-tab(index) => { root.select-tab(1, index); }
                    return-to-list => { root.focus-panels(); }
                }
                if root.quick-open : QuickView {
                    x: root.active-panel == 0 ? right-view.x : left-view.x;
                    y: root.active-panel == 0 ? right-view.y : left-view.y;
                    width: root.active-panel == 0 ? right-view.width : left-view.width;
                    height: root.active-panel == 0 ? right-view.height : left-view.height;
                    title: root.quick-title;
                    note: root.quick-note;
                    body: root.quick-text;
                    embedded: root.quick-embedded;
                    bounds-changed(bounds) => { root.quick-bounds = bounds; }
                    preview-image: root.quick-image;
                    close => { root.action("quick-view"); }
                }
                TouchArea {
                    x: root.stacked ? panels.sidebar : left-view.x + left-view.width;
                    y: root.stacked ? left-view.height : 0px;
                    width: root.stacked ? panels.files-width : panels.gap;
                    height: root.stacked ? panels.gap : panels.height;
                    mouse-cursor: root.stacked ? MouseCursor.row-resize : MouseCursor.col-resize;
                    double-clicked => { root.split-ratio = 0.5; }
                    moved => {
                        if (self.pressed) {
                            let position = root.stacked
                                ? self.absolute-position.y + self.mouse-y - panels.absolute-position.y
                                : self.absolute-position.x + self.mouse-x - panels.absolute-position.x - panels.sidebar;
                            let span = root.stacked ? panels.height : panels.files-width;
                            root.split-ratio = clamp((position - panels.gap / 2) / (span - panels.gap), 0.37, 0.63);
                        }
                    }
                    if !root.settings.panel-toolbar : Rectangle {
                        width: root.stacked ? 36px : 2px;
                        height: root.stacked ? 2px : 36px;
                        background: parent.has-hover || parent.pressed ? Colors.accent : Colors.edge;
                        border-radius: 1px;
                    }
                }
                if root.settings.panel-toolbar : Rectangle {
                    property <int> button-count: root.middle-buttons.length > 0 ? root.middle-buttons.length : self.actions.length;
                    property <[PanelAction]> actions: [
                        { icon: @image-url("icons/eye.svg"), label: @tr("Anzeigen"), command: "view" },
                        { icon: @image-url("icons/edit.svg"), label: @tr("Bearbeiten"), command: "edit" },
                        { icon: @image-url("icons/copy.svg"), label: @tr("Kopieren"), command: "copy" },
                        { icon: @image-url("icons/move.svg"), label: @tr("Verschieben"), command: "move" },
                        { icon: @image-url("icons/archive.svg"), label: @tr("Dateien packen"), command: "zip-pack" },
                        { icon: @image-url("icons/folderplus.svg"), label: @tr("Neuer Ordner"), command: "mkdir" },
                    ];
                    x: root.stacked ? panels.sidebar + (panels.files-width - self.width) / 2 : left-view.x + left-view.width + 4px;
                    y: root.stacked ? left-view.height + 4px : (panels.height - self.height) / 2;
                    width: root.stacked ? self.button-count * 38px - 4px : 34px;
                    height: root.stacked ? 34px : self.button-count * 38px - 4px;
                    for item[i] in self.actions : NavButton {
                        visible: root.middle-buttons.length == 0;
                        x: root.stacked ? i * 38px : 0px;
                        y: root.stacked ? 0px : i * 38px;
                        icon: item.icon;
                        label: item.label;
                        clicked => { root.action(item.command); }
                    }
                    for item[i] in root.middle-buttons : CustomBarButton {
                        x: root.stacked ? i * 38px : 0px;
                        y: root.stacked ? 0px : i * 38px;
                        label: item.label;
                        icon-name: item.icon;
                        custom-icon: item.custom-icon;
                        clicked => { root.custom-button(1, i); }
                    }
                }
            }
            Rectangle {
                height: root.settings.command-line ? 32px : 0px;
                visible: root.settings.command-line;
                HorizontalLayout {
                spacing: 6px;
                DetailCell {
                    text: (root.active-panel == 0 ? root.left.path : root.right.path) + " >";
                    width: 220px;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
                command := LineEdit {
                    placeholder-text: "cd <Pfad> oder Arco-Befehl";
                    accessible-label: @tr("Arco-Befehlszeile");
                    horizontal-stretch: 1;
                    accepted(value) => {
                        if (root.command-line(value)) { self.text = ""; }
                    }
                }
                NavButton { icon: @image-url("icons/terminal.svg"); label: @tr("Terminal im aktiven Ordner öffnen"); clicked => { root.action("terminal"); } }
                }
            }
            if root.settings.function-keys : HorizontalLayout {
                spacing: 6px;
                ActionButton { icon: @image-url("icons/refresh.svg"); text: root.button-label("Neu laden", root.shortcut-labels.refresh); clicked => { root.action("refresh"); } }
                ActionButton { icon: @image-url("icons/eye.svg"); text: root.button-label(@tr("Anzeigen"), root.shortcut-labels.view); clicked => { root.action("view"); } }
                ActionButton { icon: @image-url("icons/edit.svg"); text: root.button-label(@tr("Bearbeiten"), root.shortcut-labels.edit); clicked => { root.action("edit"); } }
                ActionButton { icon: @image-url("icons/copy.svg"); text: root.button-label(@tr("Kopieren"), root.shortcut-labels.copy); clicked => { root.action("copy"); } }
                ActionButton { icon: @image-url("icons/move.svg"); text: root.button-label(@tr("Verschieben"), root.shortcut-labels.move-file); clicked => { root.action("move"); } }
