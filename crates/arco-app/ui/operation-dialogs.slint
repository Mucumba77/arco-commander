import { ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Colors, Button, ActionButton, NavButton } from "dialog-theme.slint";

export component DialogHeading {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> wrap-subtitle: true;
    min-height: 42px;

    HorizontalLayout {
        spacing: 11px;
        Rectangle {
            width: 42px;
            height: 42px;
            background: Colors.cursor;
            border-radius: 10px;
            Image { width: 21px; height: 21px; source: root.icon; colorize: Colors.accent; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; color: Colors.text; font-size: 20px; font-weight: 650; overflow: elide; }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Colors.muted;
                font-size: 12px;
                wrap: root.wrap-subtitle ? word-wrap : no-wrap;
                overflow: elide;
            }
        }
    }
}

export component FieldLabel inherits Text {
    color: Colors.text;
    font-size: 12px;
    font-weight: 600;
}

component Note inherits Text {
    color: Colors.muted;
    font-size: 12px;
    wrap: word-wrap;
}

export component FormSection inherits Rectangle {
    in property <string> title;
    in property <string> description;
    background: Colors.background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Colors.edge;
    VerticalLayout {
        padding: 14px;
        spacing: 9px;
        alignment: start;
        FieldLabel { text: root.title; font-size: 14px; overflow: elide; Tooltip { text: @markdown("\{root.title}"); } }
        if root.description != "" : Note { text: root.description; }
        @children
    }
}

export enum OperationKind { task, copy, move, pack, extract, delete, search, rename, sync, ftp, plugin }

export struct JobMetrics {
    source: string,
    target: string,
    bytes: string,
    speed: string,
    elapsed: string,
    remaining: string,
    finish: string,
    items: string,
    processed: string,
    pending: string,
    matched: string,
    errors: string,
    recovering: bool,
    phase: string,
    file-fraction: float,
}

export component ProgressRail inherits Rectangle {
    in property <float> progress;
    in property <bool> indeterminate;
    in property <bool> paused;
    property <float> position;
    height: 10px;
    border-radius: self.height / 2;
    background: Colors.edge;
    clip: true;
    Timer {
        interval: 40ms;
        running: root.indeterminate && !root.paused;
        triggered => { root.position = Math.mod(root.position + 0.02, 1.0); }
    }
    Rectangle {
        x: root.indeterminate ? root.position * (parent.width - self.width) : 0px;
        width: root.indeterminate ? parent.width * 0.28 : parent.width * clamp(root.progress, 0, 1);
        height: 100%;
        border-radius: root.border-radius;
        background: root.paused ? Colors.muted : @linear-gradient(90deg, Colors.accent, #64adf5);
        animate width { duration: 180ms; easing: ease-out; }
    }
}

component MetricTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Colors.background;
    border-radius: 9px;
    min-height: 73px;
    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        Text { text: root.label; color: Colors.muted; font-size: 11px; }
        Text { text: root.value == "" ? "—" : root.value; color: Colors.text; font-size: 17px; font-weight: 600; overflow: elide; }
    }
}

export component ProgressMeter inherits VerticalLayout {
    in property <string> label: @tr("Gesamtfortschritt");
    in property <float> progress: -1;
    in property <bool> paused;
    spacing: 10px;
    HorizontalLayout {
        spacing: 16px;
        Text { text: root.label; color: Colors.muted; vertical-alignment: center; horizontal-stretch: 0; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.progress < 0 ? "…" : "\{floor(clamp(root.progress, 0, 1) * 100)} %"; min-width: 110px; horizontal-stretch: 0; horizontal-alignment: right; color: Colors.text; font-size: 30px; font-weight: 600; }
    }
    ProgressRail { progress: root.progress; indeterminate: root.progress < 0; paused: root.paused; }
}

export component ProgressMetrics inherits HorizontalLayout {
    in property <OperationKind> kind;
    in property <JobMetrics> data;
    property <bool> counted: root.kind == OperationKind.delete || root.kind == OperationKind.rename || root.kind == OperationKind.sync || ((root.kind == OperationKind.ftp || root.kind == OperationKind.plugin) && root.data.items != "" && root.data.bytes == "");
    property <bool> activity: (root.kind == OperationKind.ftp || root.kind == OperationKind.plugin) && root.data.items == "" && root.data.bytes == "";
    spacing: 9px;
    if !root.activity : MetricTile { label: root.kind == OperationKind.search ? @tr("Geprüft") : root.kind == OperationKind.rename ? @tr("Schritte erledigt") : root.kind == OperationKind.sync ? (root.data.items == "" ? @tr("Erfasste Einträge") : @tr("Aktionen erledigt")) : root.counted ? @tr("Bearbeitet") : @tr("Durchsatz"); value: root.kind == OperationKind.search || root.counted ? root.data.processed : root.data.speed; }
    if !root.activity : MetricTile { label: root.kind == OperationKind.search ? @tr("Treffer") : root.kind == OperationKind.rename ? @tr("Schritte offen") : root.kind == OperationKind.sync ? @tr("Aktionen offen") : root.counted ? @tr("Ausstehend") : @tr("Restzeit (geschätzt)"); value: root.kind == OperationKind.search ? root.data.matched : root.counted ? root.data.pending : root.data.remaining; }
    MetricTile { label: @tr("Vergangen"); value: root.data.elapsed; }
}

export struct ReviewRow { primary: string, secondary: string, detail: string, kind: string }

export component ReviewTable inherits Rectangle {
    in property <[ReviewRow]> rows;
    in property <string> primary-label;
    in property <string> secondary-label;
    property <int> selection;
    property <length> secondary-width: 230px;
    callback copy(string);
    forward-focus: keys;
    min-height: 140px;
    border-radius: 9px;
    border-color: keys.has-focus ? Colors.accent : Colors.edge;
    border-width: 1px;
    background: Colors.background;
    public function copy-current() {
        if (root.selection >= 0 && root.selection < root.rows.length) {
            let row = root.rows[root.selection];
            root.copy(row.primary + " · " + row.secondary + "\n" + row.detail);
        }
    }
    function select(index: int) {
        root.selection = clamp(index, 0, max(0, root.rows.length - 1));
        if (root.selection * 58px < -list.viewport-y) { list.viewport-y = -root.selection * 58px; }
        else if ((root.selection + 1) * 58px > -list.viewport-y + list.visible-height) { list.viewport-y = list.visible-height - (root.selection + 1) * 58px; }
    }
    changed rows => { root.selection = 0; list.viewport-y = 0px; }
    VerticalLayout {
        padding: 1px;
        spacing: 1px;
        Rectangle {
            height: 32px;
            background: Colors.surface;
            HorizontalLayout {
                padding-left: 34px; padding-right: 12px; spacing: 14px;
                FieldLabel { text: root.primary-label; horizontal-stretch: 1; vertical-alignment: center; }
                FieldLabel { text: root.secondary-label; width: root.secondary-width; vertical-alignment: center; }
            }
        }
        list := ListView {
            vertical-stretch: 1;
            accessible-label: root.primary-label + " · " + root.secondary-label;
            for row[i] in root.rows : Rectangle {
                height: 58px;
                background: i == root.selection ? Colors.cursor : Math.mod(i, 2) == 0 ? Colors.background : Colors.panel;
                accessible-role: list-item;
                accessible-label: row.primary + " · " + row.secondary + " · " + row.detail;
                HorizontalLayout {
                    padding: 10px; spacing: 9px;
                    Image { source: row.kind == "error" ? @image-url("icons/close.svg") : row.kind == "folder" ? @image-url("icons/folder.svg") : row.kind == "rename" ? @image-url("icons/edit.svg") : row.kind == "plugin" ? @image-url("icons/settings.svg") : row.kind == "ftp" ? @image-url("icons/network.svg") : @image-url("icons/file.svg"); colorize: row.kind == "error" ? Colors.archive : Colors.accent; width: 16px; height: 16px; }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 3px;
                        HorizontalLayout {
                            spacing: 14px;
                            Text { text: row.primary; color: row.kind == "error" ? Colors.archive : Colors.text; overflow: elide; horizontal-stretch: 1; Tooltip { text: @markdown("\{row.primary}"); } }
                            Text { text: row.secondary; color: Colors.text; overflow: elide; width: root.secondary-width; Tooltip { text: @markdown("\{row.secondary}"); } }
                        }
                        Text { text: row.detail; color: Colors.muted; font-size: 11px; overflow: elide; Tooltip { text: @markdown("\{row.detail}"); } }
                    }
                }
                TouchArea { clicked => { root.select(i); keys.focus(); } }
            }
        }
    }
    keys := FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.select(root.selection - 1); return accept; }
            if (event.text == Key.DownArrow) { root.select(root.selection + 1); return accept; }
            if (event.text == Key.Home) { root.select(0); return accept; }
            if (event.text == Key.End) { root.select(root.rows.length - 1); return accept; }
            if (event.text == Key.PageUp) { root.select(root.selection - max(1, floor(list.visible-height / 58px))); return accept; }
            if (event.text == Key.PageDown) { root.select(root.selection + max(1, floor(list.visible-height / 58px))); return accept; }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) { root.copy-current(); return accept; }
            return reject;
        }
    }
}

export component ReviewCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0 && root.rows.length > 0) { table.focus(); } else if (confirm-button.enabled) { confirm-button.focus(); } else { close-button.focus(); } }
    in property <OperationKind> kind;
    in property <string> title;
    in property <string> description;
    in property <[ReviewRow]> rows;
    in property <string> primary-label;
    in property <string> secondary-label;
    in property <[string]> options;
    in property <string> confirm-label;
    in property <bool> can-confirm: true;
    in property <bool> can-edit;
    property <int> choice;
    changed options => { root.choice = 0; }
    callback confirm(int);
    callback edit();
    callback close();
    callback copy-all();
    callback copy-row(string);
    background: Colors.panel;
    border-radius: 16px;
    border-color: Colors.edge;
    border-width: 1px;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        DialogHeading { icon: root.kind == OperationKind.search ? @image-url("icons/search.svg") : root.kind == OperationKind.ftp ? @image-url("icons/network.svg") : root.kind == OperationKind.plugin ? @image-url("icons/settings.svg") : @image-url("icons/edit.svg"); title: root.title; subtitle: root.description; }
        table := ReviewTable { rows: root.rows; primary-label: root.primary-label; secondary-label: root.secondary-label; vertical-stretch: 1; copy(text) => { root.copy-row(text); } }
        if root.rows.length == 0 : Note { text: @tr("Keine Einträge vorhanden."); }
        if root.options.length > 0 : ComboBox { model: root.options; current-index <=> root.choice; accessible-label: @tr("Ergebnisaktion"); }
        HorizontalLayout {
            spacing: 7px;
            Button { text: @tr("Zeile kopieren"); enabled: root.rows.length > 0; clicked => { table.copy-current(); } }
            Button { text: @tr("Text kopieren"); clicked => { root.copy-all(); } }
            Rectangle { horizontal-stretch: 1; }
            if root.can-edit : Button { text: @tr("Bearbeiten"); clicked => { root.edit(); } }
            close-button := Button { text: @tr("Schließen"); clicked => { root.close(); } }
            confirm-button := Button { text: root.confirm-label; primary: true; enabled: root.can-confirm; clicked => { root.confirm(root.choice); } }
        }
    }
    init => { if (root.rows.length > 0) { table.focus(); } else { close-button.focus(); } }
}

export component TransferProgressCard inherits Rectangle {
    in property <OperationKind> kind;
    in property <string> origin;
    in property <string> target;
    in property <string> title;
    in property <string> detail;
    in property <JobMetrics> data;
    in property <float> progress: -1;
    in property <bool> cancelling;
    in property <bool> pausable;
    in property <bool> paused;
    property <bool> deleting: root.kind == OperationKind.delete;
    property <bool> counted: root.deleting || root.kind == OperationKind.rename || root.kind == OperationKind.sync || ((root.kind == OperationKind.ftp || root.kind == OperationKind.plugin) && root.data.items != "" && root.data.bytes == "");
    callback pause();
    callback cancel();
    callback hide-progress();
    background: Colors.panel;
    border-radius: 18px;
    border-width: 1px;
    border-color: Colors.edge;
    FocusScope {
        width: 0px; height: 0px;
        changed has-focus => { if (self.has-focus) { background-button.focus(); } }
    }
    VerticalLayout {
        padding: 24px;
        spacing: 17px;
        DialogHeading {
            icon: root.deleting ? @image-url("icons/trash.svg")
                : root.kind == OperationKind.ftp ? @image-url("icons/network.svg")
                : root.kind == OperationKind.plugin ? @image-url("icons/settings.svg")
                : root.kind == OperationKind.search ? @image-url("icons/search.svg")
                : root.kind == OperationKind.rename ? @image-url("icons/edit.svg")
                : root.kind == OperationKind.sync ? @image-url("icons/sync.svg")
                : root.kind == OperationKind.move ? @image-url("icons/move.svg")
                : root.kind == OperationKind.pack ? @image-url("icons/archive.svg")
                : root.kind == OperationKind.extract ? @image-url("icons/archive-extract.svg")
                : root.kind == OperationKind.copy ? @image-url("icons/copy.svg") : @image-url("icons/file.svg");
            title: root.title;
            subtitle: root.cancelling && !root.data.recovering ? @tr("Abbruch angefordert …") : root.data.phase;
        }
        if root.origin != "" || root.target != "" : Rectangle {
            background: Colors.background;
            border-radius: 9px;
            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                if root.origin != "" : FieldLabel { text: root.kind == OperationKind.search ? @tr("Suchbereich") : root.kind == OperationKind.sync ? @tr("Links") : root.kind == OperationKind.extract ? @tr("Quellarchiv") : @tr("Quelle"); }
                if root.origin != "" : Text { text: root.origin; color: Colors.muted; font-size: 12px; overflow: elide; Tooltip { text: @markdown("\{root.origin}"); } }
                if root.target != "" : FieldLabel { text: root.kind == OperationKind.sync ? @tr("Rechts") : root.kind == OperationKind.pack ? @tr("Zielarchiv") : @tr("Ziel"); }
                if root.target != "" : Text { text: root.target; color: Colors.text; font-size: 12px; overflow: elide; Tooltip { text: @markdown("\{root.target}"); } }
            }
        }
        ProgressMeter { label: root.kind == OperationKind.search ? @tr("Suchfortschritt") : @tr("Gesamtfortschritt"); progress: root.progress; paused: root.paused || (root.cancelling && !root.data.recovering); }
        ProgressMetrics { kind: root.kind; data: root.data; }
        if !root.counted && root.kind != OperationKind.search : HorizontalLayout {
            spacing: 8px;
            Text { text: root.data.items; color: Colors.accent; font-size: 12px; horizontal-stretch: 1; }
            Text { text: root.data.bytes; color: Colors.muted; font-size: 12px; }
        }
        if root.data.finish != "" : Text {
            text: @tr("Voraussichtlich fertig:") + " " + root.data.finish;
            color: Colors.muted; font-size: 12px; horizontal-alignment: right;
        }
        if root.data.source != "" : VerticalLayout {
            spacing: 5px;
            FieldLabel { text: root.kind == OperationKind.search ? @tr("Aktueller Pfad") : root.counted ? @tr("Aktueller Eintrag") : @tr("Aktuelle Datei"); }
            Text { text: root.data.source; color: Colors.text; overflow: elide; font-size: 13px; Tooltip { text: @markdown("\{root.data.source}"); } }
            if root.target == "" && root.data.target != "" : Text { text: "→ " + root.data.target; color: Colors.muted; overflow: elide; font-size: 12px; Tooltip { text: @markdown("\{root.data.target}"); } }
            if root.data.file-fraction >= 0 : ProgressRail { height: 5px; progress: root.data.file-fraction; paused: root.paused; }
        }
        if root.data.source == "" && root.detail != "" : Text { text: root.detail; color: Colors.muted; wrap: word-wrap; overflow: elide; }
        if root.deleting : Note {
            text: @tr("Dateien und Ordner werden als einzelne Einträge gezählt. Bei Abbruch kann der aktuelle Eintrag noch abgeschlossen werden.");
        }
        if root.kind == OperationKind.search && root.data.errors != "" && root.data.errors != "0" : Note { text: @tr("Lesefehler") + ": " + root.data.errors; color: Colors.archive; }
        if root.kind == OperationKind.rename : Note { text: @tr("Bei Abbruch versucht Arco, bereits ausgeführte Umbenennungen zurückzusetzen."); }
        Rectangle { height: 1px; background: Colors.edge; }
        HorizontalLayout {
            spacing: 8px;
            pause-button := Button { text: root.paused ? @tr("Fortsetzen") : @tr("Pausieren"); visible: root.pausable; enabled: !root.cancelling; clicked => { root.pause(); } }
            Rectangle { horizontal-stretch: 1; }
            cancel-button := Button { text: @tr("Abbrechen"); destructive: true; enabled: !root.cancelling && !root.data.recovering; clicked => { root.cancel(); } }
            background-button := Button { text: @tr("Im Hintergrund"); primary: true; clicked => { root.hide-progress(); } }
        }
    }
    FocusScope {
        width: 0px; height: 0px;
        changed has-focus => { if (self.has-focus) { if (root.pausable && !root.cancelling) { pause-button.focus(); } else if (!root.cancelling) { cancel-button.focus(); } else { background-button.focus(); } } }
    }
    init => { background-button.focus(); }
}

export component FileOperationCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle < 0) { start-button.focus(); } else { selection-toggle.focus(); } }
    in property <string> title;
    in property <string> selection-count;
    in property <string> selected-paths;
    in property <string> initial-value;
    in-out property <string> target-folder;
    in property <OperationKind> kind;
    property <bool> pack: root.kind == OperationKind.pack;
    property <bool> extract: root.kind == OperationKind.extract;
    in property <bool> multiple;
    in property <bool> password-enabled;
    in property <string> note;
    in property <[string]> choices;
    in property <string> choices-label;
    in property <[string]> filters;
    in property <string> confirm-label;
    in-out property <int> filter-index;
    out property <length> content-height: heading.preferred-height + fields.preferred-height + footer.preferred-height
        + layout.padding * 2 + layout.spacing * 3 + divider.height;
    property <bool> selection-open: true;
    property <bool> advanced;
    property <bool> password-available: root.password-enabled && (!root.pack || choice.current-index == 0 || choice.current-index == 1 || choice.current-index == 4 || choice.current-index == 6 || choice.current-index == 9 || choice.current-index == 10 || choice.current-index == 14);
    property <bool> password-required: root.password-enabled && root.pack && choice.current-index == 14;
    property <bool> can-submit: (root.multiple || main-input.text != "") && (!root.pack || root.target-folder != "") && (!root.password-required || secondary.text != "");
    callback start(string, string, int);
    callback dismiss();
    callback browse-target() -> string;

    background: Colors.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: Colors.edge;

    function submit() {
        if (root.can-submit) {
            root.start(root.multiple ? "" : main-input.text, root.pack && !root.password-available ? "" : secondary.text, choice.current-index);
        }
    }

    function choose-target() {
        let selected = root.browse-target();
        if (selected != "") {
            if (root.pack) { root.target-folder = selected; } else { main-input.text = selected; }
        }
    }

    layout := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        heading := DialogHeading {
            icon: root.pack ? @image-url("icons/archive.svg") : root.extract ? @image-url("icons/archive-extract.svg") : root.kind == OperationKind.move ? @image-url("icons/move.svg") : @image-url("icons/copy.svg");
            title: root.title;
            subtitle: root.selection-count;
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: fields.preferred-height;
            fields := VerticalLayout {
                width: parent.visible-width;
                padding-right: 3px;
                spacing: 9px;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: @tr("Quelle"); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    selection-toggle := Button {
                        text: root.selection-open ? @tr("Auswahl ausblenden") : @tr("Auswahl anzeigen");
                        clicked => { root.selection-open = !root.selection-open; }
                    }
                }
                if root.selection-open : TextEdit {
                    height: 83px;
                    read-only: true;
                    wrap: no-wrap;
                    text: root.selected-paths;
                    accessible-label: @tr("Ausgewählte Quelldateien");
                }
                Rectangle { height: 1px; background: Colors.edge; }
                FieldLabel { text: @tr("Zielordner"); }
                if root.pack : HorizontalLayout {
                    spacing: 7px;
                    LineEdit { text <=> root.target-folder; accessible-label: @tr("Zielordner"); accepted => { root.submit(); } }
                    NavButton { icon: @image-url("icons/folder.svg"); label: @tr("Zielordner auswählen"); clicked => { root.choose-target(); } }
                }
                if root.multiple : TextEdit {
                    height: 80px;
                    read-only: true;
                    wrap: no-wrap;
                    text: root.initial-value;
                    accessible-label: @tr("Markierte Zielordner");
                }
                if root.pack : FieldLabel { text: @tr("Archivname"); }
                HorizontalLayout {
                    visible: !root.multiple;
                    spacing: 7px;
                    main-input := LineEdit {
                        text: root.initial-value;
                        accessible-label: root.pack ? @tr("Archivname") : @tr("Zielordner");
                        accepted => { root.submit(); }
                    }
                    if !root.pack : NavButton { icon: @image-url("icons/folder.svg"); label: @tr("Zielordner auswählen"); clicked => { root.choose-target(); } }
                }
                if root.choices.length > 0 : FieldLabel { text: root.choices-label != "" ? root.choices-label : root.pack ? @tr("Archivformat") : @tr("Bei Namenskonflikten"); }
                choice := ComboBox {
                    visible: root.choices.length > 0;
                    model: root.choices;
                    current-index: 0;
                    accessible-label: root.choices-label != "" ? root.choices-label : root.pack ? @tr("Archivformat") : @tr("Bei Namenskonflikten");
                }
                if !root.pack && !root.extract && (!root.multiple || root.filters.length > 0) : HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        icon: @image-url("icons/settings.svg");
                        text: @tr("Erweiterte Optionen");
                        checkable: true;
                        checked: root.advanced;
                        clicked => { root.advanced = !root.advanced; }
                    }
                }
                if root.password-available || (root.advanced && !root.multiple) : FieldLabel {
                    text: root.password-required ? @tr("Archivpasswort (erforderlich)") : root.password-available ? @tr("Archivpasswort (optional)") : @tr("Zielmaske (optional)");
                }
                secondary := LineEdit {
                    visible: root.password-available || (root.advanced && !root.multiple);
                    placeholder-text: root.password-required ? @tr("Archivpasswort (erforderlich)") : root.password-available ? @tr("Archivpasswort (optional)") : "*.bak";
                    accessible-label: root.password-required ? @tr("Archivpasswort (erforderlich)") : root.password-available ? @tr("Archivpasswort (optional)") : @tr("Zielmaske (optional)");
                    input-type: root.password-available ? password : text;
                    accepted => { root.submit(); }
                }
                if root.advanced && !root.pack && root.filters.length > 0 : FieldLabel { text: @tr("Gespeicherter Suchfilter"); }
                if root.advanced && !root.pack && root.filters.length > 0 : ComboBox {
                    model: root.filters;
                    current-index <=> root.filter-index;
                    accessible-label: @tr("Gespeicherter Suchfilter");
                }
                if root.note != "" : Note { text: root.note; }
            }
        }
        divider := Rectangle { height: 1px; background: Colors.edge; }
        footer := HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Abbrechen"); clicked => { root.dismiss(); } }
            start-button := Button { text: root.confirm-label; primary: true; enabled: root.can-submit; clicked => { root.submit(); } }
        }
    }

    init => {
        if (root.multiple) { start-button.focus(); }
        else { main-input.focus(); }
    }
}

export component ReaderPane inherits FocusScope {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle > 0) { search.focus(); } }
    in property <bool> busy;
    in property <bool> hex;
    in property <bool> can-back;
    in property <bool> can-next;
    in property <int> encoding;
    in property <[string]> encodings;
    in property <string> body;
    property <bool> tools-open;
    property <bool> wrap-text: true;
    callback navigate(string);
    callback control(int, string, int);

    key-pressed(event) => {
        if (event.modifiers.control && !event.modifiers.alt && event.text == "f") {
            search.focus();
            return accept;
        }
        if (event.modifiers.alt && !root.busy && event.text == Key.LeftArrow && root.can-back) {
            root.navigate("viewer-back");
            return accept;
        }
        if (event.modifiers.alt && !root.busy && event.text == Key.RightArrow && root.can-next) {
            root.navigate("viewer-next");
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 44px;
            background: Colors.surface;
            border-radius: 8px;
            HorizontalLayout {
                padding: 5px;
                spacing: 5px;
                NavButton { icon: @image-url("icons/back.svg"); label: @tr("Vorheriger Abschnitt"); enabled: !root.busy && root.can-back; clicked => { root.navigate("viewer-back"); } }
                NavButton { icon: @image-url("icons/forward.svg"); label: @tr("Nächster Abschnitt"); enabled: !root.busy && root.can-next; clicked => { root.navigate("viewer-next"); } }
                ActionButton {
                    icon: @image-url("icons/code.svg");
                    text: "Hex";
                    accessible-label: @tr("Hexansicht umschalten");
                    checkable: true;
                    checked: root.hex;
                    enabled: !root.busy;
                    clicked => { root.navigate("viewer-toggle"); }
                }
                search := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: root.hex ? @tr("Hexbytes suchen") : @tr("Text suchen");
                    accessible-label: self.placeholder-text;
                    enabled: !root.busy;
                    accepted => { if self.text != "" { root.control(2, self.text, 0); } }
                }
                NavButton { icon: @image-url("icons/search.svg"); label: @tr("Weitersuchen"); enabled: !root.busy && search.text != ""; clicked => { root.control(2, search.text, 0); } }
                NavButton { icon: @image-url("icons/refresh.svg"); label: @tr("Ab Anfang suchen"); enabled: !root.busy && search.text != ""; clicked => { root.control(3, search.text, 0); } }
                NavButton { icon: @image-url("icons/settings.svg"); label: @tr("Anzeigeoptionen"); checkable: true; checked: root.tools-open; clicked => { root.tools-open = !root.tools-open; } }
            }
        }
        if root.tools-open : HorizontalLayout {
            spacing: 6px;
            ComboBox {
                model: root.encodings;
                current-index: root.encoding;
                enabled: !root.busy && !root.hex;
                accessible-label: @tr("Textkodierung");
                selected => { root.control(0, "", self.current-index); }
            }
            Button {
                text: @tr("Zeilenumbruch");
                checkable: true;
                checked: root.wrap-text;
                enabled: !root.hex;
                clicked => { root.wrap-text = !root.wrap-text; }
            }
            position := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: @tr("Byte-Offset (dezimal oder 0x)");
                accessible-label: self.placeholder-text;
                enabled: !root.busy;
                accepted => { if self.text != "" { root.control(1, self.text, 0); } }
            }
            Button { text: @tr("Springen"); enabled: !root.busy && position.text != ""; clicked => { root.control(1, position.text, 0); } }
        }
        reader := TextEdit {
            vertical-stretch: 1;
            read-only: true;
            font-family: "Consolas";
            font-size: 14px;
            wrap: !root.hex && root.wrap-text ? word-wrap : no-wrap;
            accessible-label: @tr("Dateiinhalt");
            text: root.body;
        }
    }
    init => { reader.focus(); }
}

export component ImagePane inherits Rectangle {
    in property <image> picture;
    in property <int> zoom;
    background: Colors.background;
    border-radius: 9px;
    clip: true;
    if root.zoom == 0 : Image {
        width: parent.width - 16px;
        height: parent.height - 16px;
        x: 8px;
        y: 8px;
        image-fit: contain;
        source: root.picture;
    }
    if root.zoom > 0 : ScrollView {
        viewport-width: max(self.visible-width, root.picture.width * root.zoom * 1px / 100);
        viewport-height: max(self.visible-height, root.picture.height * root.zoom * 1px / 100);
        Image {
            width: root.picture.width * root.zoom * 1px / 100;
            height: root.picture.height * root.zoom * 1px / 100;
            x: max(0px, (parent.viewport-width - self.width) / 2);
            y: max(0px, (parent.viewport-height - self.height) / 2);
            image-fit: contain;
            source: root.picture;
        }
    }
}

export struct TransferManagerData {
    active: string,
    pausable: bool,
    paused: bool,
    waiting: [string],
    retry: bool,
    descriptions: bool,
}

export component TransferManagerCard inherits Rectangle {
    in property <int> focus-cycle;
    changed focus-cycle => { if (root.focus-cycle < 0) { close-button.focus(); } else if (root.cancelling || (root.data.active == "" && root.data.waiting.length == 0)) { descriptions-button.focus(); } }
    in property <TransferManagerData> data;
    in property <bool> cancelling;
    callback choose(int);
    callback dismiss();

    background: Colors.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: Colors.edge;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        DialogHeading {
            icon: @image-url("icons/move.svg");
            title: @tr("Transfermanager");
        }
        Rectangle {
            background: Colors.surface;
            border-radius: 8px;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                FieldLabel { text: @tr("Aktueller Transfer"); }
                Note {
                    text: root.data.active == "" ? @tr("Kein Transfer aktiv.") : root.data.active;
                }
                if root.data.active != "" : HorizontalLayout {
                    spacing: 6px;
                    if root.data.paused : FieldLabel { text: @tr("Pausiert"); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        property <int> cycle: root.focus-cycle;
                        changed cycle => { if (self.cycle > 0 && self.enabled) { self.focus(); } }
                        text: root.data.paused ? @tr("Fortsetzen") : @tr("Pausieren");
                        enabled: root.data.pausable && !root.cancelling;
                        clicked => { root.choose(0); }
                    }
                    Button {
                        property <int> cycle: root.focus-cycle;
                        changed cycle => { if (self.cycle > 0 && !root.data.pausable && self.enabled) { self.focus(); } }
                        text: @tr("Transfer abbrechen");
                        enabled: !root.cancelling;
                        clicked => { root.choose(1); }
                    }
                }
            }
        }
        FieldLabel { text: @tr("Wartende Aufträge") + "  ·  \{root.data.waiting.length}"; }
        if root.data.waiting.length == 0 : Note { text: @tr("Keine Transfers vorgemerkt."); }
        if root.data.waiting.length > 0 : ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalLayout {
                width: parent.visible-width;
                spacing: 4px;
                for entry[i] in root.data.waiting : Button {
                    property <int> cycle: root.focus-cycle;
                    changed cycle => { if (self.cycle > 0 && i == 0 && root.data.active == "") { self.focus(); } }
                    text: "\{i + 1}.  \{entry}";
                    clicked => { root.choose(6 + i); }
                }
            }
        }
        if root.data.waiting.length == 0 : Rectangle { vertical-stretch: 1; }
        Rectangle { height: 1px; background: Colors.edge; }
        HorizontalLayout {
            spacing: 6px;
            descriptions-button := Button {
                text: @tr("Dateikommentare mitführen");
                checkable: true;
                checked: root.data.descriptions;
                clicked => { root.choose(5); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Letzte Kopie erneut versuchen");
                enabled: root.data.retry;
                clicked => { root.choose(3); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            ActionButton {
                icon: @image-url("icons/settings.svg");
                text: @tr("Geschwindigkeit und Protokoll");
                clicked => { root.choose(4); }
            }
            Rectangle { horizontal-stretch: 1; }
            close-button := Button { text: @tr("Schließen"); primary: true; clicked => { root.dismiss(); } }
        }
    }
    init => { close-button.focus(); }
}

export component CompactDialogCard inherits Rectangle {
    in property <int> focus-cycle;
    in property <bool> input;
    in property <int> revision;
    in property <string> title;
    in property <string> description;
    in property <string> value;
    in property <string> secondary-value;
    in property <string> label;
    in property <string> secondary-label;
    in property <string> options-label;
    in property <string> confirm-label;
    in property <bool> secret;
    in property <bool> secondary-secret;
    in property <[string]> options;
    property <string> first: root.value;
    property <string> second: root.secondary-value;
    property <int> choice;
    callback submit(string, string, int);
    callback dismiss();

    background: Colors.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: Colors.edge;

    changed revision => {
        root.first = root.value;
        root.second = root.secondary-value;
        root.choice = 0;
    }

    VerticalLayout {
        padding: 17px;
        spacing: 10px;
        alignment: start;
        DialogHeading {
            icon: root.input ? @image-url("icons/edit.svg") : @image-url("icons/check.svg");
            title: root.title;
            subtitle: root.description;
        }
        if root.input : VerticalLayout {
            spacing: 4px;
            if root.label != "" : FieldLabel { text: root.label; }
            prompt-input := LineEdit {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle > 0) { self.focus(); } }
                text <=> root.first;
                input-type: root.secret ? password : text;
                accessible-label: root.label;
                accepted => { root.submit(root.first, root.second, root.choice); }
                init => { self.focus(); }
            }
        }
        if root.input && root.secondary-label != "" : VerticalLayout {
            spacing: 4px;
            FieldLabel { text: root.secondary-label; }
            LineEdit {
                text <=> root.second;
                input-type: root.secondary-secret ? password : text;
                accessible-label: root.secondary-label;
                accepted => { root.submit(root.first, root.second, root.choice); }
            }
        }
        if root.options.length > 0 : VerticalLayout {
            spacing: 4px;
            FieldLabel { text: root.options-label == "" ? @tr("Auswahl") : root.options-label; }
            ComboBox {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle > 0 && !root.input) { self.focus(); } }
                model: root.options;
                current-index <=> root.choice;
                accessible-label: root.options-label == "" ? @tr("Auswahl") : root.options-label;
                init => { if (!root.input) { self.focus(); } }
            }
        }
        Rectangle { height: 1px; background: Colors.edge; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle > 0 && !root.input && root.options.length == 0) { self.focus(); } }
                text: @tr("Abbrechen");
                clicked => { root.dismiss(); }
                init => { if (!root.input && root.options.length == 0) { self.focus(); } }
            }
            Button {
                property <int> cycle: root.focus-cycle;
                changed cycle => { if (self.cycle < 0) { self.focus(); } }
                text: root.confirm-label != "" ? root.confirm-label
                    : root.options.length > 0 ? @tr("Auswahl bestätigen") : @tr("Bestätigen");
                primary: true;
                clicked => { root.submit(root.first, root.second, root.choice); }
            }
        }
    }
}
